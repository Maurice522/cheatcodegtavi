{
  "name": "cheatcodegtavi",
  "compatibility_date": "2026-09-19",
  // "main" turns this from a plain static-assets deploy into a Worker that
  // handles /api/* itself and falls through to the static build for
  // everything else — see worker/index.ts and README-worker.md.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [{ "binding": "CHEATCODEGTAVI_KV", "id": "9e75802518014a1abc3f4b8fe4a8bc38" }],
  "routes": [
    { "pattern": "cheatcodegtavi.com", "custom_domain": true },
    { "pattern": "www.cheatcodegtavi.com", "custom_domain": true }
  ]
}

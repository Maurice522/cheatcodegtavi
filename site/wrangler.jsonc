{
  "name": "cheatcodegtavi",
  "compatibility_date": "2026-09-19",
  // "main" turns this from a plain static-assets deploy into a Worker that
  // handles /api/* itself and falls through to the static build for
  // everything else — see worker/index.ts and README-worker.md.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Placeholder id — run `wrangler kv namespace create CHEATCODEGTAVI_KV`
  // and paste the real id here before deploying (README-worker.md).
  "kv_namespaces": [{ "binding": "CHEATCODEGTAVI_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "routes": [
    { "pattern": "cheatcodegtavi.com", "custom_domain": true },
    { "pattern": "www.cheatcodegtavi.com", "custom_domain": true }
  ]
}

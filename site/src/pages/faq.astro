---
import { generalCheatFaq } from '../lib/cheat-faq';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const baseFaqs = [
  {
    q: 'Are the GTA 6 cheat codes on this site confirmed?',
    a: "The codes on our Confirmed GTA 6 Cheats page are reported working in GTA 6 by Rockstar or by at least two major outlets, and each source is linked. We haven't tested them on our own PS5 yet, so they're labeled \"reported\". The 35 codes on our cheat codes page are GTA V cheats.",
  },
  {
    q: 'How do you confirm a GTA 6 cheat?',
    a: 'Every hour we check Rockstar and major gaming outlets. A code is listed only when its exact input appears on an official Rockstar page, or in articles from at least two different outlets published after launch that plainly say it works in GTA 6. Sites that only repost lists, and articles that call codes rumored or untested, never count.',
  },
  {
    q: 'Do cheat codes cost money or require DLC?',
    a: "No. Cheat codes have always been a free, built-in feature of mainline GTA games, and GTA 6's cheats are unlocked by playing, not by buying anything.",
  },
  {
    q: 'Can I turn a cheat off after turning it on?',
    a: "Most GTA cheats toggle: entering the same code again switches the effect off. A few, like spawning a vehicle or getting money, are one-shot. In GTA 6, cheats also disable saving for the session, so reloading your save is the surest way back to normal.",
  },
  {
    q: 'What do "Verified" and "Rumored" mean on the news page?',
    a: 'On Leaks & Updates, Verified means a story has been confirmed by two or more independent sources, or directly by Rockstar. Rumored means it comes from a single source and hasn\'t been cross-referenced yet.',
  },
];
const faqs = [...generalCheatFaq, ...baseFaqs];
---

<Layout
  title="GTA 6 (GTA VI) Cheat Codes FAQ"
  description="GTA 6 cheat codes FAQ: how to unlock and enter cheats on PS5, trophies and saving, GTA 5 codes in GTA 6, online play, and how we confirm codes."
>
  <PageHero eyebrow="Good to Know" title="Frequently Asked Questions" subtitle="How GTA 6 cheats unlock, how to enter them, and how we confirm each code." accent="cyan" />

  <div class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20" data-reveal-group>
    <div class="flex flex-col gap-4">
      {faqs.map((item) => (
        <details data-reveal class="group rounded-xl border border-border-default bg-bg-surface p-5 open:border-accent-secondary/40">
          <summary class="text-heading-sm flex cursor-pointer list-none items-center justify-between gap-4 text-text-primary marker:content-none">
            {item.q}
            <svg
              class="h-4 w-4 shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-45"
              viewBox="0 0 16 16"
              fill="none"
            >
              <path d="M8 2V14M2 8H14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </summary>
          <p class="text-body-md mt-3 text-text-secondary">{item.a}</p>
        </details>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-center gap-3 rounded-xl border border-dashed border-border-default p-8 text-center">
      <p class="text-body-md text-text-secondary">Still have a question this didn't answer?</p>
      <a
        href="/leaks/"
        class="press text-label rounded-full border border-border-default px-6 py-3 text-text-primary transition-colors duration-150 hover:border-accent-secondary/60"
      >
        Check Leaks &amp; Updates
      </a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  })} />
</Layout>

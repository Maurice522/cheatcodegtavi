---
import Layout from '../../layouts/Layout.astro';
import LeakCard from '../../components/LeakCard.astro';
import { getAllLeaks, getLeakBySlug } from '../../lib/leaks';

export async function getStaticPaths() {
  const leaks = await getAllLeaks();
  return leaks.map((l) => ({ params: { slug: l.slug } }));
}

const { slug } = Astro.params;
const leak = await getLeakBySlug(slug as string);

if (!leak) return Astro.redirect('/leaks/');

// Up to three more stories: prefer ones sharing a tag, then fill with the latest.
const allLeaks = await getAllLeaks();
const others = allLeaks.filter((l) => l.slug !== leak.slug);
const sharesTag = others.filter((l) => l.tags.some((t) => leak.tags.includes(t)));
const related = [...sharesTag, ...others.filter((l) => !sharesTag.includes(l))].slice(0, 3);

const labelMeaning: Record<typeof leak.credibility, string> = {
  official: 'A direct statement or announcement from Rockstar or Take-Two.',
  confirmed: 'Widely corroborated by several outlets, or shown in official trailers or marketing.',
  rumor: 'A single-source claim, leak, or datamine that has not been corroborated.',
};

const credibilityStyles: Record<typeof leak.credibility, string> = {
  official: 'bg-verified/15 text-verified border-verified/30',
  confirmed: 'bg-accent-secondary/15 text-accent-secondary border-accent-secondary/30',
  rumor: 'bg-rumored/15 text-rumored border-rumored/30',
};

const credibilityLabels: Record<typeof leak.credibility, string> = {
  official: 'Official',
  confirmed: 'Confirmed',
  rumor: 'Rumor',
};

const sourceName = leak.sourceName ?? leak.sourceLinks[0]?.title;
const sourceUrl = leak.sourceLinks[0]?.url;

const date = new Date(leak.publishedAt).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

{/*
  noindex: these pages are auto-rewritten from RSS sources on a schedule with
  no human editorial review before publish. Keeping the pipeline running (per
  team decision) but excluding every leak article from search/AdSense review
  until T4's human-reviewed news format replaces this. See
  CheatCodeGTAVI Content Quality & Pre-Launch Plan, T3.
*/}
<Layout title={leak.title} description={leak.summary} noindex>
  <article class="mx-auto max-w-3xl px-5 py-12 sm:px-8 sm:py-16">
    <nav class="text-caption mb-6 text-text-muted">
      <a href="/leaks/" class="hover:text-text-primary">Leaks &amp; Updates</a>
      <span class="mx-2">/</span>
      <span class="text-text-secondary">{leak.title}</span>
    </nav>

    <span class:list={['text-label inline-flex items-center rounded-full border px-2.5 py-1', credibilityStyles[leak.credibility]]}>
      {credibilityLabels[leak.credibility]}
    </span>

    <h1 class="text-display-md mt-4 text-3xl text-text-primary sm:text-4xl">{leak.title}</h1>

    <div class="text-body-sm mt-4 flex flex-wrap items-center gap-2 text-text-muted">
      {sourceName && <span class="font-medium uppercase text-text-secondary">{sourceName}</span>}
      {sourceName && <span aria-hidden="true">·</span>}
      <time>{date}</time>
    </div>

    {leak.image && (
      <div class="mt-6 aspect-video w-full overflow-hidden rounded-xl bg-bg-elevated">
        <img src={leak.image} alt="" class="h-full w-full object-cover" />
      </div>
    )}

    <p class="text-body-lg mt-8 max-w-2xl whitespace-pre-line text-text-secondary">{leak.summary}</p>

    <div class="mt-6 flex flex-wrap gap-2">
      {leak.tags.map((tag) => (
        <span class="text-caption rounded-full border border-border-default px-2.5 py-1 text-text-muted">#{tag}</span>
      ))}
    </div>

    {sourceUrl && (
      <a
        href={sourceUrl}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="press text-label mt-10 inline-flex items-center gap-2 rounded-full bg-accent-secondary px-6 py-3 text-text-on-accent transition-transform duration-150 hover:scale-105"
      >
        Read the full story at {sourceName ?? 'the source'} &#8599;
      </a>
    )}

    <p class="text-caption mt-6 text-text-muted">
      <strong class="text-text-secondary">{credibilityLabels[leak.credibility]}:</strong> {labelMeaning[leak.credibility]} This summary is generated automatically from the linked story; read <a href="/editorial-policy/" class="text-accent-secondary hover:underline">how we label and write news</a>.
    </p>

    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="text-heading-md text-text-primary">More GTA 6 stories</h2>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
          {related.map((r) => (
            <LeakCard leak={r} />
          ))}
        </div>
      </section>
    )}

    <div class="mt-10 border-t border-border-subtle pt-6">
      <a href="/leaks/" class="text-label inline-block text-accent-secondary hover:text-accent-secondary/80">
        &larr; Back to Leaks &amp; Updates
      </a>
    </div>
  </article>
</Layout>

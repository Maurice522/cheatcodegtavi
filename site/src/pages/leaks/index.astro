---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import LeakCard from '../../components/LeakCard.astro';
import { getAllLeaks } from '../../lib/leaks';

const leaks = await getAllLeaks();
---

<Layout title="Leaks & Updates" description="Every GTA6 leak and official update, tracked and cross-referenced.">
  <PageHero
    eyebrow="Tracked Daily"
    title="Leaks & Updates"
    subtitle="Official announcements and community leaks, clearly labeled so you always know how solid the source is."
    accent="cyan"
  />
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16" data-reveal-group>
    <div class="mb-6 flex justify-end">
      <a
        href="/leaks/rss.xml"
        class="text-label inline-flex items-center gap-1.5 rounded-full border border-border-default px-3 py-1.5 text-text-secondary transition-colors duration-150 hover:border-accent-tertiary/60 hover:text-accent-tertiary"
      >
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
          <circle cx="3.5" cy="12.5" r="1.5" fill="currentColor" />
          <path d="M2 7a7 7 0 0 1 7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <path d="M2 2a12 12 0 0 1 12 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        RSS Feed
      </a>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {leaks.map((leak) => (
        <div id={leak.slug} data-reveal>
          <LeakCard leak={leak} />
        </div>
      ))}
    </div>
  </div>
</Layout>

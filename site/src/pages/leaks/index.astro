---
import LeaksListing from '../../components/LeaksListing.astro';
import { getAllLeaks, LEAKS_PER_PAGE } from '../../lib/leaks';

const leaks = await getAllLeaks();
const totalPages = Math.max(1, Math.ceil(leaks.length / LEAKS_PER_PAGE));
---

<LeaksListing leaks={leaks.slice(0, LEAKS_PER_PAGE)} page={1} {totalPages} />

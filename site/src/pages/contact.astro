---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="Contact Us"
  description="Get in touch with CheatCodeGTAVI.com: report a correction, send a leak tip, or ask a question about GTA 6 cheat codes."
>
  <PageHero
    eyebrow="Get in Touch"
    title="Contact Us"
    subtitle="Spotted a mistake, have a lead on a leak, or just have a question? Send us a message."
    accent="cyan"
  />

  <div class="mx-auto flex max-w-2xl flex-col gap-10 px-5 py-14 text-text-secondary sm:px-8 sm:py-20">
    <contact-form class="block">
      <form data-contact-form class="flex flex-col gap-4 rounded-xl border border-border-default bg-bg-surface p-6" novalidate>
        <div>
          <label for="contact-name" class="text-label mb-1.5 block text-text-muted">Name (optional)</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            maxlength="100"
            class="text-body-sm w-full rounded-lg border border-border-default bg-bg-primary px-3 py-2.5 text-text-primary focus:border-accent-secondary/60 focus:outline-none"
          />
        </div>
        <div>
          <label for="contact-email" class="text-label mb-1.5 block text-text-muted">Your email (only if you want a reply)</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            class="text-body-sm w-full rounded-lg border border-border-default bg-bg-primary px-3 py-2.5 text-text-primary focus:border-accent-secondary/60 focus:outline-none"
          />
        </div>
        <div>
          <label for="contact-message" class="text-label mb-1.5 block text-text-muted">Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            required
            minlength="10"
            maxlength="4000"
            class="text-body-sm w-full rounded-lg border border-border-default bg-bg-primary px-3 py-2.5 text-text-primary focus:border-accent-secondary/60 focus:outline-none"
          ></textarea>
        </div>
        <!-- Honeypot: hidden from people, tempting to bots. -->
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="contact-website">Leave this empty</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <button
            type="submit"
            data-contact-submit
            class="press shadow-glow-pink text-label rounded-full bg-accent-primary px-6 py-3 text-text-on-accent transition-transform duration-150 hover:scale-105 disabled:pointer-events-none disabled:opacity-60"
          >
            Send message
          </button>
          <p data-contact-status role="status" class="text-body-sm"></p>
        </div>
      </form>
    </contact-form>

    <div class="flex flex-col gap-3">
      <h2 class="text-heading-sm text-text-primary">Reporting a leak or a correction</h2>
      <p class="text-body-md">
        If you've spotted a GTA 6 leak we haven't covered, or think something we've published is wrong or outdated, include a link to your source. Our <a href="/editorial-policy/" class="text-accent-secondary hover:text-accent-secondary/80">editorial policy</a> explains how we label sources, and corrections to factual errors get priority.
      </p>
    </div>

    <div class="flex flex-col gap-3">
      <h2 class="text-heading-sm text-text-primary">Press and legal</h2>
      <p class="text-body-md">
        For press inquiries or copyright and legal concerns, use the form above and start your message with "Press" or "Legal" so it gets routed correctly.
      </p>
    </div>
  </div>

  <script>
    class ContactForm extends HTMLElement {
      connectedCallback() {
        const form = this.querySelector<HTMLFormElement>('[data-contact-form]');
        const submit = this.querySelector<HTMLButtonElement>('[data-contact-submit]');
        const status = this.querySelector<HTMLElement>('[data-contact-status]');
        if (!form || !submit || !status) return;

        const show = (text: string, ok: boolean) => {
          status.textContent = text;
          status.className = `text-body-sm ${ok ? 'text-verified' : 'text-error'}`;
        };

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
          if (!data.message || data.message.trim().length < 10) {
            show('Please write at least a sentence or two.', false);
            return;
          }
          submit.disabled = true;
          show('Sending...', true);
          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify(data),
            });
            const body = (await res.json().catch(() => ({}))) as { error?: string };
            if (res.ok) {
              form.reset();
              show("Thanks, we've got your message.", true);
            } else {
              show(body.error ?? 'Something went wrong. Please try again.', false);
            }
          } catch {
            show('Could not reach the server. Please try again.', false);
          } finally {
            submit.disabled = false;
          }
        });
      }
    }
    customElements.define('contact-form', ContactForm);
  </script>
</Layout>

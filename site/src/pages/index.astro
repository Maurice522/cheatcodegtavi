---
import Layout from '../layouts/Layout.astro';
import Countdown from '../components/Countdown.astro';
import LeakCard from '../components/LeakCard.astro';
import HeroArt from '../components/HeroArt.astro';
import NotifySignup from '../components/NotifySignup.astro';
import { getLatestLeaks } from '../lib/leaks';

const latestLeaksResult = await getLatestLeaks(3);
// Defensive: getLatestLeaks can only reject to [] on a Mongo error today, but a
// crashed homepage on a leaks hiccup is worse than a briefly-empty section.
const latestLeaks = Array.isArray(latestLeaksResult) ? latestLeaksResult : [];
---

<Layout
  title="GTA 6 Cheat Codes, Leaks & Release Date Countdown"
  description="Auto-updated, verified GTA 6 cheat codes, leaks, and news — plus a live countdown to the GTA 6 release date on November 19, 2026. Every leak sourced and cross-referenced."
>
  <section class="bg-scanlines relative overflow-hidden border-b border-border-subtle" data-cursor-glow>
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--color-pink-500) 18%, transparent), transparent 45%), radial-gradient(circle at 80% 30%, color-mix(in srgb, var(--color-cyan-500) 16%, transparent), transparent 50%), radial-gradient(circle at 50% 90%, color-mix(in srgb, var(--color-purple-500) 14%, transparent), transparent 55%);"
    >
    </div>
    <HeroArt />
    <div
      data-hero-timeline
      class="relative mx-auto flex max-w-6xl flex-col items-center gap-8 px-5 pb-24 pt-20 text-center sm:px-8 sm:pb-32 sm:pt-28"
    >
      <span data-hero-item class="text-label text-accent-secondary">GTA6 launches November 19, 2026</span>
      <h1 class="text-display-xl text-4xl text-text-primary sm:text-7xl">
        EVERY <span class="text-accent-primary">CHEAT CODE</span><br />THE MOMENT IT DROPS
      </h1>
      <p data-hero-item class="text-body-lg max-w-xl text-text-secondary">
        Cross-referenced, rewritten, and verified — plus every leak and update worth knowing before launch.
      </p>
      <div data-hero-item>
        <Countdown />
      </div>
      <div class="flex flex-wrap justify-center gap-3 pt-2">
        <a
          href="/cheats"
          class="press shadow-glow-pink text-label rounded-full bg-accent-primary px-6 py-3 text-text-on-accent transition-transform duration-150 hover:scale-105"
        >
          Browse Cheat Codes
        </a>
        <a
          href="/leaks"
          class="press text-label rounded-full border border-border-default px-6 py-3 text-text-primary transition-colors duration-150 hover:border-accent-secondary/60"
        >
          Latest Leaks
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8" data-reveal-group>
    <div class="mb-8 flex items-center justify-between" data-reveal>
      <h2 class="text-heading-lg text-text-primary">Cheat Codes</h2>
      <a href="/cheats" class="text-label text-accent-secondary hover:text-accent-secondary/80">Learn more</a>
    </div>
    <div
      data-reveal
      class="flex flex-col items-center gap-3 rounded-2xl border border-border-default bg-bg-surface px-6 py-16 text-center"
    >
      <span class="text-label text-accent-primary">Coming Soon</span>
      <p class="text-body-lg max-w-xl text-text-secondary">
        No verified GTA6 cheat codes exist yet. Once Rockstar ships the game on November 19, 2026, this section
        fills in with real, cross-referenced codes as our pipeline confirms them.
      </p>
      <div class="mt-2 w-full max-w-md border-t border-border-subtle pt-6">
        <p class="text-label mb-3 text-text-muted">Don't want to check back manually?</p>
        <NotifySignup />
      </div>
    </div>
  </section>

  <section class="bg-section-alt mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:rounded-3xl" data-reveal-group>
    <div class="mb-8 flex items-center justify-between" data-reveal>
      <h2 class="text-heading-lg text-text-primary">Leaks &amp; Updates</h2>
      <a href="/leaks" class="text-label text-accent-secondary hover:text-accent-secondary/80">View all</a>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {latestLeaks.map((leak) => (
        <div data-reveal data-tilt style="transform-style: preserve-3d;">
          <LeakCard leak={leak} />
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-16 sm:px-8" data-reveal-group>
    <div class="flex flex-col gap-10 text-text-secondary">
      <div data-reveal>
        <h2 class="text-heading-lg text-text-primary">Everything You Need to Know About GTA 6 Cheat Codes</h2>
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-heading-sm text-text-primary">Will GTA 6 have cheat codes?</h3>
        <p class="text-body-md">
          Every mainline Grand Theft Auto game since GTA III has shipped with a set of built-in cheat codes, so it
          would be a genuine first for the series if Grand Theft Auto 6 skipped them entirely. Rockstar hasn't
          published an official list yet — and won't until close to launch — but GTA 6 cheat codes existing in some
          form is close to a certainty based on two decades of series history. What's genuinely unknown is the
          delivery method: GTA 5 used a phone dial-in system instead of a button-code menu, and GTA 6's marketing
          leans even further into phone-based interaction, so a similar approach looks like the most likely
          carryover.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-heading-sm text-text-primary">When do GTA 6 cheats come out?</h3>
        <p class="text-body-md">
          Short answer: not yet, and that's by design, not a bug on this site. GTA 6 cheat codes are not available
          yet because the game itself hasn't launched — Rockstar has confirmed a GTA 6 release date of November 19,
          2026, and no cheat code becomes real, testable, or "Verified" a day before that. Anyone claiming to have a
          working GTA 6 cheat codes list right now is guessing, recycling GTA 5 codes, or making it up outright. The
          countdown at the top of this page tracks the actual release date in real time, and the moment Rockstar
          ships the game, our automated pipeline starts cross-referencing every code claim as it appears.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-heading-sm text-text-primary">GTA 6 cheat codes on PS5 and Xbox</h3>
        <p class="text-body-md">
          GTA 6 is launching on PlayStation 5 and Xbox Series X|S — there's no PC release date announced yet. That
          matters for cheats, because historically GTA cheat codes have worked identically across console platforms;
          the input method differs (phone dial-in versus a button sequence, depending on the game) but the effects
          themselves don't. Once real codes are confirmed, we'll publish GTA 6 cheat codes for PS5 and GTA 6 cheat
          codes for Xbox side by side, flagging any platform-specific quirks the moment we find them.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-heading-sm text-text-primary">Coming from GTA 5? Start with the comparison</h3>
        <p class="text-body-md">
          If you're wondering whether your favorite GTA 5 cheat codes carry over, our <a href="/cheats/gta5-vs-gta6" class="text-accent-secondary hover:text-accent-secondary/80">GTA 5 vs GTA 6 cheat codes</a> page tracks every classic code — invincibility, infinite ammo, weather changes, wanted-level resets — and
          whether it's been confirmed to return. It's the fastest way to see what's likely to still work before
          Rockstar makes anything official.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-heading-sm text-text-primary">GTA 6 leaks, news, and rumors — sourced, not guessed</h3>
        <p class="text-body-md">
          Beyond cheat codes, this site runs a live newsroom for <a href="/leaks" class="text-accent-secondary hover:text-accent-secondary/80">GTA 6 leaks and updates</a>: official Rockstar Newswire posts alongside community leaks and rumors, each one clearly labeled "Verified"
          or "Rumored" so you always know how solid the source is. Nothing gets published as fact until at least two
          independent sources agree, or Rockstar confirms it directly — and every article links back to where it
          came from.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-heading-sm text-text-primary">Explore the world before you play it</h3>
        <p class="text-body-md">
          While you wait, our <a href="/characters" class="text-accent-secondary hover:text-accent-secondary/80">Characters</a> and <a href="/locations" class="text-accent-secondary hover:text-accent-secondary/80">Locations</a> pages
          break down what's known about Jason, Lucia, and the rest of the cast, plus the current state of Leonida —
          GTA 6's Miami-inspired map, including Vice City itself. It's the deepest rundown of the world you'll find
          outside actually playing the game.
        </p>
      </div>

      <p data-reveal class="text-body-md">
        Bookmark this page and check back — this site rewrites itself automatically every two hours as new leaks
        land, so it stays current without you having to dig through forums yourself.
      </p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Grand Theft Auto VI',
    alternateName: 'GTA 6',
    releaseDate: '2026-11-19',
    publisher: { '@type': 'Organization', name: 'Rockstar Games' },
    gamePlatform: ['PlayStation 5', 'Xbox Series X|S'],
    url: 'https://cheatcodegtavi.com',
  })} />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Countdown from '../components/Countdown.astro';
import LeakCard from '../components/LeakCard.astro';
import HeroArt from '../components/HeroArt.astro';
import NotifySignup from '../components/NotifySignup.astro';
import CheatEntry from '../components/CheatEntry.astro';
import { getLatestLeaks } from '../lib/leaks';
import { allCheats, cheatGroups, getFeatured, groupPath } from '../lib/gta5-cheats';
import { hasLaunched } from '../lib/launch';
import Gta6CheatCard from '../components/Gta6CheatCard.astro';
import { getReportedGta6Cheats, reportedBy } from '../lib/gta6-cheats';

const launched = hasLaunched();

const featuredCheats = getFeatured();
// GTA 6 cheats confirmed by the hourly watcher (official source or 2+ outlets).
const reported = await getReportedGta6Cheats();
const outlets = [...new Set(reported.flatMap((c) => reportedBy(c).split(/, | and /)))];

const latestLeaksResult = await getLatestLeaks(3);
// Defensive: getLatestLeaks can only reject to [] on a Mongo error today, but a
// crashed homepage on a leaks hiccup is worse than a briefly-empty section.
const latestLeaks = Array.isArray(latestLeaksResult) ? latestLeaksResult : [];
---

<Layout
  title="GTA 6 (GTA VI) Cheat Codes, Leaks & Countdown"
  description={reported.length ? `GTA 6 / GTA VI cheat codes for PS5: ${reported.length} confirmed GTA 6 cheats with codes and unlock conditions, all 35 GTA 5 codes, and the latest GTA 6 news.` : 'GTA 6 / GTA VI cheat codes for PS5, checked hourly against Rockstar and major outlets, plus all 35 GTA 5 codes and the latest GTA 6 news.'}
>
  <section class="bg-scanlines relative overflow-hidden border-b border-border-subtle" data-cursor-glow>
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--color-pink-500) 18%, transparent), transparent 45%), radial-gradient(circle at 80% 30%, color-mix(in srgb, var(--color-cyan-500) 16%, transparent), transparent 50%), radial-gradient(circle at 50% 90%, color-mix(in srgb, var(--color-purple-500) 14%, transparent), transparent 55%);"
    >
    </div>
    <HeroArt />
    <div
      data-hero-timeline
      class="relative mx-auto flex max-w-6xl flex-col items-center gap-8 px-5 pb-24 pt-20 text-center sm:px-8 sm:pb-32 sm:pt-28"
    >
      <span data-hero-item class="text-label text-accent-secondary">{reported.length ? `GTA 6 is out: ${reported.length} cheats confirmed so far` : launched ? 'GTA 6 is out: we check for confirmed cheats every hour' : 'GTA6 launches November 19, 2026'}</span>
      <h1 class="text-display-xl text-4xl text-text-primary sm:text-7xl">
        GTA 6 <span class="text-accent-primary">CHEAT CODES</span><br />{reported.length ? 'CONFIRMED ON PS5' : launched ? 'THE GAME IS OUT' : 'BEFORE THE GAME DROPS'}
      </h1>
      <p data-hero-item class="text-body-lg max-w-xl text-text-secondary">
        {reported.length
          ? `${reported.length} GTA 6 cheats reported working by ${outlets.slice(0, 3).join(', ')}, with their D-pad codes and unlock conditions. New ones are added as major outlets confirm them.`
          : launched
          ? `GTA 6 is out. We check Rockstar and major gaming outlets every hour and list GTA 6 cheats as soon as they're confirmed. Until then, here are the ${allCheats.length} GTA V codes.`
          : `${allCheats.length} PS5 cheat codes are listed now: GTA V codes most likely to return, marked unconfirmed for GTA 6. Plus every leak and update before launch.`}
      </p>
      <a
        data-hero-item
        href={reported.length ? '/cheats/gta-6/' : '/cheats/'}
        class="press text-label inline-flex items-center gap-2.5 rounded-full border border-accent-primary/50 bg-accent-primary/10 px-5 py-2.5 text-accent-primary transition-colors duration-150 hover:bg-accent-primary/20"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-primary opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-primary"></span>
        </span>
        {reported.length ? `${reported.length} confirmed GTA 6 cheats · PS5` : `${allCheats.length} cheat codes available · PS5`}
      </a>
      <div data-hero-item>
        <Countdown />
      </div>
      <div class="flex flex-wrap justify-center gap-3 pt-2">
        <a
          href={reported.length ? '/cheats/gta-6/' : '/cheats/'}
          class="press shadow-glow-pink text-label rounded-full bg-accent-primary px-6 py-3 text-text-on-accent transition-transform duration-150 hover:scale-105"
        >
          {reported.length ? 'See GTA 6 Cheats' : 'Browse PS5 Cheat Codes'}
        </a>
        <a
          href="/leaks/"
          class="press text-label rounded-full border border-border-default px-6 py-3 text-text-primary transition-colors duration-150 hover:border-accent-secondary/60"
        >
          Latest Leaks
        </a>
      </div>
    </div>
  </section>

  {
    reported.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 pt-16 sm:px-8">
        <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
          <h2 class="text-heading-lg text-text-primary">Confirmed GTA 6 Cheats</h2>
          <span class="flex gap-4"><a href="/cheats/gta-6/tracker/" class="text-label text-accent-secondary hover:text-accent-secondary/80">Unlock tracker</a><a href="/cheats/gta-6/" class="text-label text-accent-secondary hover:text-accent-secondary/80">View all {reported.length}</a></span>
        </div>
        <p class="text-body-md mb-8 max-w-2xl text-text-secondary">Reported working in GTA 6 by Rockstar or at least two major outlets. Cheats unlock after the main story, and each has its own unlock requirement.</p>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
          {reported.slice(0, 6).map((cheat) => <Gta6CheatCard cheat={cheat} />)}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8" data-reveal-group>
    <div class="mb-3 flex flex-wrap items-end justify-between gap-3" data-reveal>
      <h2 class="text-heading-lg text-text-primary">{launched ? 'GTA V Cheat Codes (PS5)' : 'PS5 Cheat Codes'}</h2>
      <a href="/cheats/" class="text-label text-accent-secondary hover:text-accent-secondary/80">View all {allCheats.length} codes</a>
    </div>
    <p data-reveal class="text-body-md mb-8 max-w-2xl text-text-secondary">
      {launched
        ? `These are GTA V's ${allCheats.length} cheats with PS5 inputs. GTA 6 has its own cheat list and entry method, and we haven't tested whether any GTA V code carries over.`
        : `GTA 6 cheat codes aren't confirmed yet. These ${allCheats.length} GTA V cheats are the most likely to return, shown with PS5 inputs. Each is marked unconfirmed until we can test it after launch.`}
    </p>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
      {featuredCheats.map((cheat) => (
        <div data-reveal>
          <CheatEntry cheat={cheat} compact />
        </div>
      ))}
    </div>
    <div data-reveal class="mt-6 flex flex-wrap items-center gap-2">
      <span class="text-caption text-text-muted">Browse by category:</span>
      {cheatGroups.map((group) => (
        <a
          href={groupPath(group.slug)}
          class="press text-caption rounded-full border border-border-default px-3 py-1.5 text-text-secondary transition-colors duration-150 hover:border-accent-secondary/60 hover:text-text-primary"
        >
          {group.name}
        </a>
      ))}
    </div>
    <div data-reveal class="mt-10 w-full max-w-md border-t border-border-subtle pt-6">
      <p class="text-label mb-3 text-text-muted">Want a heads-up when GTA 6 codes are confirmed?</p>
      <NotifySignup />
    </div>
  </section>

  <section class="bg-section-alt mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:rounded-3xl" data-reveal-group>
    <div class="mb-8 flex items-center justify-between" data-reveal>
      <h2 class="text-heading-lg text-text-primary">Leaks &amp; Updates</h2>
      <a href="/leaks/" class="text-label text-accent-secondary hover:text-accent-secondary/80">View all</a>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {latestLeaks.map((leak) => (
        <div data-reveal data-tilt style="transform-style: preserve-3d;">
          <LeakCard leak={leak} />
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-16 sm:px-8" data-reveal-group>
    <div class="flex flex-col gap-10 text-text-secondary">
      <div data-reveal>
        <h2 class="text-heading-lg text-text-primary">Everything You Need to Know About GTA 6 Cheat Codes</h2>
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-heading-sm text-text-primary">Does GTA 6 have cheat codes?</h3>
        <p class="text-body-md">
          Yes. GTA 6 keeps the series tradition of built-in cheats: Polygon and Eurogamer report around 60 of them,
          grouped into Player, Combat, Spawn Vehicle, Environment and Screen Filters cheats. They work differently from
          GTA 5. You can't use any until you've finished the main story, each one unlocks only when you meet its own
          requirement, and using one disables saving and trophies for that session.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-heading-sm text-text-primary">How to enter GTA 6 cheats on PS5</h3>
        <p class="text-body-md">
          Take out your phone with Up on the D-pad, hold L1 and R1 on the home screen, then press the cheat's D-pad
          code. Each code on our <a href="/cheats/gta-6/" class="text-accent-secondary hover:text-accent-secondary/80">confirmed GTA 6 cheats</a> page shows its exact input and unlock requirement. We list a code only when Rockstar or at least two major outlets report the same one, and we check for new ones every hour.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-heading-sm text-text-primary">GTA 6 cheat codes on PS5 and Xbox</h3>
        <p class="text-body-md">
          GTA 6 launched on November 19, 2026 for PlayStation 5 and Xbox Series X|S, with no PC release date yet.
          Its cheat codes are D-pad sequences. Outlets have reported the PS5 version so far, so we list PS5 inputs.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-heading-sm text-text-primary">Coming from GTA 5? Start with the comparison</h3>
        <p class="text-body-md">
          If you're wondering whether your favorite GTA 5 cheat codes carry over, our <a href="/cheats/gta5-vs-gta6/" class="text-accent-secondary hover:text-accent-secondary/80">GTA 5 vs GTA 6 cheat codes</a> page lists every classic GTA 5 code next to GTA 6's own cheat system. GTA 6 uses different codes, entered on the phone after the story, so start with the <a href="/cheats/gta-6/" class="text-accent-secondary hover:text-accent-secondary/80">confirmed GTA 6 cheats</a> if you're playing the new game.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-heading-sm text-text-primary">GTA 6 leaks, news, and rumors — sourced, not guessed</h3>
        <p class="text-body-md">
          Beyond cheat codes, this site runs a live newsroom for <a href="/leaks/" class="text-accent-secondary hover:text-accent-secondary/80">GTA 6 leaks and updates</a>: official Rockstar Newswire posts alongside community leaks and rumors, each one clearly labeled "Verified"
          or "Rumored" so you always know how solid the source is. Nothing gets published as fact until at least two
          independent sources agree, or Rockstar confirms it directly — and every article links back to where it
          came from.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-heading-sm text-text-primary">Explore the world before you play it</h3>
        <p class="text-body-md">
          While you wait, our <a href="/characters/" class="text-accent-secondary hover:text-accent-secondary/80">Characters</a> and <a href="/locations/" class="text-accent-secondary hover:text-accent-secondary/80">Locations</a> pages
          break down what's known about Jason, Lucia, and the rest of the cast, plus the current state of Leonida —
          GTA 6's Miami-inspired map, including Vice City itself. It's the deepest rundown of the world you'll find
          outside actually playing the game.
        </p>
      </div>

      <p data-reveal class="text-body-md">
        Bookmark this page and check back — this site rewrites itself automatically every two hours as new leaks
        land, so it stays current without you having to dig through forums yourself.
      </p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Grand Theft Auto VI',
    alternateName: 'GTA 6',
    releaseDate: '2026-11-19',
    publisher: { '@type': 'Organization', name: 'Rockstar Games' },
    gamePlatform: ['PlayStation 5', 'Xbox Series X|S'],
    url: 'https://cheatcodegtavi.com',
  })} />
</Layout>

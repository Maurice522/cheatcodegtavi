---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found">
  <div class="mx-auto flex max-w-xl flex-col items-center gap-4 px-5 py-28 text-center">
    <p class="text-display-lg text-6xl text-accent-primary">404</p>
    <h1 class="text-heading-lg text-text-primary">Off the Grid.</h1>
    <p class="text-body-lg text-text-secondary">
      This page doesn't exist — or the cheat you're after hasn't been found yet.
    </p>
    <a
      href="/"
      class="press text-label mt-2 rounded-full bg-accent-primary px-6 py-3 text-text-on-accent transition-transform duration-150 hover:scale-105"
    >
      Back to Safety
    </a>
  </div>
</Layout>

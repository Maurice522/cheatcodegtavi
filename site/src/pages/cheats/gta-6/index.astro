---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import Gta6CheatCard from '../../../components/Gta6CheatCard.astro';
import NotifySignup from '../../../components/NotifySignup.astro';
import { getReportedGta6Cheats, gta6CheatPath } from '../../../lib/gta6-cheats';
import CheatCatalog from '../../../components/CheatCatalog.astro';
import { getCheatCatalog } from '../../../lib/cheat-catalog';

const cheats = await getReportedGta6Cheats();
const count = cheats.length;
const catalog = await getCheatCatalog();
const total = catalog.length || 61;
const withCode = catalog.filter((c) => c.codes.length).length;
---

<Layout
  ogImage="/og/gta-6/all.png"
  title={`GTA 6 Cheats: All ${total} Cheat Codes, Unlocks & ${count} Confirmed (GTA VI)`}
  description={count
    ? `All ${total} GTA 6 cheats with unlock requirements, every code reported so far and who reported it, plus ${count} codes confirmed by two major outlets. PS5 and Xbox.`
    : 'No GTA 6 / GTA VI cheat codes are confirmed yet. We check official and major gaming sources every hour and list codes here as soon as they are reported.'}
>
  <PageHero
    eyebrow={count ? `${count} reported · Checked hourly` : 'Checked hourly'}
    title="GTA 6 Cheat Codes"
    subtitle={`All ${total} GTA 6 cheats with their unlock requirements, and the ${count} codes confirmed by major outlets.`}
    accent="gold"
  />

  <div class="mx-auto max-w-4xl px-5 py-12 sm:px-8 sm:py-16">
    <nav aria-label="Breadcrumb" class="text-caption mb-6 text-text-muted">
      <a href="/" class="hover:text-text-primary">Home</a>
      <span class="mx-2">/</span>
      <a href="/cheats/" class="hover:text-text-primary">Cheat Codes</a>
      <span class="mx-2">/</span>
      <span class="text-text-secondary">Confirmed GTA 6</span>
    </nav>

    <div class="rounded-xl border border-dashed border-border-default bg-bg-surface p-5">
      <p class="text-body-sm text-text-secondary">
        <strong class="text-text-primary">Short answer:</strong> GTA 6 has about 61 cheats in five groups (Player, Combat, Spawn Vehicle, Environment and Screen Filters). They unlock after you finish the main story, each has its own requirement, and you enter them on the phone while holding L1 and R1 (LB and RB on Xbox). {count > 0 ? `${count} codes are confirmed below.` : ''} <a href="/cheats/gta-6/tracker/" class="text-accent-secondary hover:underline">Track your unlocks</a>.
      </p>
      <p class="text-body-sm mt-3 text-text-secondary">
        <strong class="text-text-primary">How a code gets here:</strong> every hour we check Rockstar and major gaming outlets. A code is listed only when its exact input appears on an official Rockstar page, or in articles from at least two different outlets published after GTA 6 came out. We link every source. "Reported" means we haven't tested it on our own PS5 yet.
      </p>
    </div>

    {
      count > 0 && (
        <section class="mt-8 rounded-xl border border-border-default bg-bg-surface p-5">
          <h2 class="text-heading-md text-text-primary">How to activate cheats in GTA 6</h2>
          <ol class="text-body-sm mt-3 flex list-decimal flex-col gap-2 pl-5 text-text-secondary">
            <li>Finish the main story. Cheats stay locked until the credits roll.</li>
            <li>Unlock each cheat by meeting its requirement (shown on each card). Progress made before the ending counts.</li>
            <li>Take out your phone (press Up on the D-pad), hold L1 and R1 (LB and RB on Xbox), then enter the D-pad code.</li>
            <li>Save first: using a cheat disables saving and trophies for that session.</li>
          </ol>
          <p class="text-caption mt-3 text-text-muted">As reported by <a href="https://www.polygon.com/gta-6-cheat-codes-list-unlock/" rel="nofollow noopener" target="_blank" class="text-accent-secondary hover:underline">Polygon</a> and <a href="https://www.eurogamer.net/all-gta-6-cheats" rel="nofollow noopener" target="_blank" class="text-accent-secondary hover:underline">Eurogamer</a>. We haven't tested this on our own PS5 yet. <a href="/cheats/gta-6/how-to-activate-cheats/" class="text-accent-secondary hover:underline">Full guide: unlocking, trophies, saving and fixes</a>.</p>
        </section>
      )
    }

    {
      count ? (
        <div class="mt-8 grid grid-cols-1 gap-3 md:grid-cols-2">
          {cheats.map((cheat) => <Gta6CheatCard cheat={cheat} />)}
        </div>
      ) : (
        <div class="mt-8 flex flex-col items-center gap-3 rounded-xl border border-dashed border-border-default p-10 text-center">
          <p class="text-body-lg text-text-secondary">No GTA 6 cheat codes are confirmed yet.</p>
          <p class="text-body-sm text-text-muted">Until then, see the <a href="/cheats/" class="text-accent-secondary hover:underline">35 GTA V cheats</a>.</p>
        </div>
      )
    }

    {
      catalog.length > 0 && (
        <section id="all-cheats" class="mt-14 scroll-mt-24">
          <h2 class="text-heading-lg text-text-primary">All {total} GTA 6 cheats and how to unlock them</h2>
          <p class="text-body-md mt-3 text-text-secondary">
            Every GTA 6 cheat, grouped the way the game lists them, with its unlock requirement. {withCode} have a code reported by at least one outlet so far. Each code shows who reported it: only <strong class="text-verified">Confirmed</strong> codes have passed our checks (two major outlets, exact code, after launch). Others may still change, so use them with care. Updated automatically every hour.
          </p>
          <div class="mt-6"><CheatCatalog cheats={catalog} /></div>
        </section>
      )
    }

    <div class="mt-14 flex flex-col items-center gap-3 rounded-2xl border border-dashed border-border-default p-8 text-center">
      <p class="text-label text-text-muted">Get an email when new GTA 6 codes are confirmed</p>
      <NotifySignup />
    </div>
  </div>

  {
    count > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Confirmed GTA 6 cheat codes',
        numberOfItems: count,
        itemListElement: cheats.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.title,
          url: `https://cheatcodegtavi.com${gta6CheatPath(c.slug)}`,
        })),
      })} />
    )
  }
</Layout>

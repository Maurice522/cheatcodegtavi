---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import Gta6CheatCard from '../../../components/Gta6CheatCard.astro';
import { getReportedGta6Cheats, gta6CheatPath, outletName, reportedBy, searchAliases, effectSentence, unlockClause, type Gta6Cheat } from '../../../lib/gta6-cheats';
import { allCheats } from '../../../lib/gta5-cheats';

export async function getStaticPaths() {
  const cheats = await getReportedGta6Cheats();
  return cheats.map((cheat) => ({ params: { slug: cheat.slug }, props: { cheat } }));
}

const { cheat } = Astro.props as { cheat: Gta6Cheat };
const gta5 = cheat.gta5Slug ? allCheats.find((c) => c.slug === cheat.gta5Slug) : undefined;
const others = (await getReportedGta6Cheats()).filter((c) => c.slug !== cheat.slug).slice(0, 6);
const url = `https://cheatcodegtavi.com${gta6CheatPath(cheat.slug)}`;
const by = reportedBy(cheat);
const aliases = searchAliases(cheat.slug);
const code = cheat.ps5?.join(', ') ?? 'not reported yet';
const effect = effectSentence(cheat.effect);
const unlock = unlockClause(cheat.unlock);
const faq = [
  {
    q: `What is the ${cheat.title} cheat code in GTA 6 (GTA VI)?`,
    a: `${effect ? `${effect} ` : ''}The code is ${code} on both PS5 and Xbox Series X|S. It was reported working in GTA 6 by ${by}.`,
  },
  ...(aliases.length
    ? [{
        q: `What is the ${aliases[0]} in GTA 6?`,
        a: `The GTA 6 ${aliases[0]} is the ${cheat.title} cheat: ${code}. ${effect}`.trim(),
      }]
    : []),
  {
    q: `How do I unlock the ${cheat.title} cheat in GTA 6?`,
    a: cheat.unlock
      ? `Finish the main story first; cheats stay locked until then. The ${cheat.title} cheat then unlocks when you meet its requirement: ${unlock}.`
      : `Finish the main story first; cheats stay locked until then. The ${cheat.title} cheat's own unlock requirement hadn't been reported when we listed it.`,
  },
  {
    q: `How do I enter the ${cheat.title} cheat on PS5 and Xbox?`,
    a: `Take out your phone with Up on the D-pad, hold L1 and R1 (LB and RB on Xbox Series X|S), then press ${cheat.ps5?.join(', ') ?? 'the code'}. Save first: using a cheat disables saving and trophies for that session.`,
  },
  {
    q: `Is the GTA 6 ${cheat.title} cheat confirmed?`,
    a: `It is reported working by ${by}${cheat.sources.length > 1 ? ', independently' : ''}. We haven't tested it on our own PS5 yet, and will update this page when we do.`,
  },
];
---

<Layout
  title={`GTA 6 ${cheat.title} Cheat Code (PS5 & Xbox) | GTA VI`}
  description={`GTA 6 ${cheat.title} cheat${aliases[0] ? ` (${aliases[0]})` : ''}: ${code} on PS5 and Xbox.${unlock ? ` Unlock: ${unlock}.` : ''} Reported by ${by}.`}
  ogType="article"
>
  <PageHero eyebrow={`Reported by ${by}`} title={`GTA 6 ${cheat.title} Cheat`} subtitle={cheat.effect || 'Reported working in GTA 6.'} accent="gold" />

  <div class="mx-auto max-w-3xl px-5 py-12 sm:px-8 sm:py-16">
    <nav aria-label="Breadcrumb" class="text-caption mb-6 text-text-muted">
      <a href="/" class="hover:text-text-primary">Home</a>
      <span class="mx-2">/</span>
      <a href="/cheats/gta-6/" class="hover:text-text-primary">Confirmed GTA 6 Cheats</a>
      <span class="mx-2">/</span>
      <span class="text-text-secondary">{cheat.title}</span>
    </nav>

    <p class="text-body-lg mb-6 text-text-secondary" data-answer>
      The GTA 6 {cheat.title} cheat code is <strong class="text-text-primary">{code}</strong> on PS5 and Xbox Series X|S. {effect} To use it, finish the main story{unlock ? `, unlock it (${unlock})` : ''}, then open your phone with Up on the D-pad, hold L1 + R1 (LB + RB on Xbox) and enter the code. Code reported by {by}; Xbox buttons as reported by Radio Times.
    </p>
    {aliases.length > 0 && <p class="text-body-sm -mt-3 mb-6 text-text-muted">Also searched as the GTA 6 {aliases.join(' or ')}.</p>}

    <Gta6CheatCard cheat={cheat} headingLevel="h2" link={false} />

    <p class="text-body-sm mt-4"><a href="/cheats/gta-6/tracker/" class="text-accent-secondary hover:underline">Track which GTA 6 cheats you've unlocked</a></p>

    <section class="mt-10">
      <h2 class="text-heading-md text-text-primary">How to use the {cheat.title} cheat in GTA 6</h2>
      <ol class="text-body-md mt-4 flex list-decimal flex-col gap-2 pl-6 text-text-secondary">
        <li>Finish the main story. Cheats stay locked until the credits roll, then a Cheats option appears at the end of the Progress menu.</li>
        <li>{unlock ? `Unlock this cheat: ${unlock}.` : "Meet this cheat's unlock requirement (not reported yet)."} Progress from before the ending counts.</li>
        <li>Save your game. Using a cheat disables saving and trophies for the rest of that session.</li>
        <li>Take out your phone (Up on the D-pad), hold L1 and R1 (LB and RB on Xbox), and enter {cheat.ps5?.length ? cheat.ps5.join(', ') : 'the code'}.</li>
      </ol>
      <p class="text-caption mt-3 text-text-muted">Steps as reported by {by}. We haven't tested them on our own PS5 yet. <a href="/cheats/gta-6/how-to-activate-cheats/" class="text-accent-secondary hover:underline">Cheat not working? See the full activation guide</a>.</p>
    </section>

    <section class="mt-10">
      <h2 class="text-heading-md text-text-primary">Sources</h2>
      <ul class="text-body-sm mt-3 flex flex-col gap-2 text-text-secondary">
        {
          cheat.sources.map((s) => (
            <li>
              <a href={s.url} rel="nofollow noopener" target="_blank" class="text-accent-secondary hover:underline">{outletName(s.outlet)}: {s.title}</a>
            </li>
          ))
        }
      </ul>
      <p class="text-caption mt-3 text-text-muted">Listed because the exact code appears in each source above. See our <a href="/editorial-policy/" class="text-accent-secondary hover:underline">editorial policy</a>.</p>
    </section>

    {
      gta5 && (
        <p class="text-body-sm mt-8 rounded-xl border border-border-default bg-bg-surface p-4 text-text-secondary">
          This is the same code as GTA V's <a href={`/cheats/code/${gta5.slug}/`} class="text-accent-secondary hover:underline">{gta5.title}</a> cheat.
        </p>
      )
    }

    <section class="mt-10">
      <h2 class="text-heading-md text-text-primary">Questions</h2>
      <div class="mt-4 flex flex-col gap-3">
        {
          faq.map((item) => (
            <details class="rounded-xl border border-border-default bg-bg-surface p-5" open>
              <summary class="text-heading-sm cursor-pointer list-none text-text-primary marker:content-none">{item.q}</summary>
              <p class="text-body-md mt-3 text-text-secondary">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    {
      others.length > 0 && (
        <section class="mt-10">
          <h2 class="text-heading-md text-text-primary">More confirmed GTA 6 cheats</h2>
          <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
            {others.map((c) => (
              <li><a href={gta6CheatPath(c.slug)} class="press block rounded-xl border border-border-default bg-bg-surface p-4 text-text-primary hover:border-accent-secondary/60">{c.title}</a></li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebPage',
        '@id': url,
        url,
        name: `GTA 6 ${cheat.title} Cheat Code (PS5 & Xbox)`,
        alternateName: aliases.map((a) => `GTA 6 ${a}`),
        datePublished: cheat.verifiedAt,
        dateModified: cheat.verifiedAt,
        about: { '@type': 'VideoGame', name: 'Grand Theft Auto VI', alternateName: ['GTA 6', 'GTA VI'] },
        citation: cheat.sources.map((s) => s.url),
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cheatcodegtavi.com/' },
          { '@type': 'ListItem', position: 2, name: 'Confirmed GTA 6 Cheats', item: 'https://cheatcodegtavi.com/cheats/gta-6/' },
          { '@type': 'ListItem', position: 3, name: cheat.title, item: url },
        ],
      },
      {
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      },
    ],
  })} />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CheatEntry from '../../components/CheatEntry.astro';
import NotifySignup from '../../components/NotifySignup.astro';
import { cheatGroups, cheatsInGroup, getGroup, groupPath } from '../../lib/gta5-cheats';

export function getStaticPaths() {
  return cheatGroups.map((group) => ({ params: { slug: group.slug } }));
}

const { slug } = Astro.params;
const group = getGroup(slug!)!;
const cheats = cheatsInGroup(group.slug);
const others = cheatGroups.filter((g) => g.slug !== group.slug);
const url = `https://cheatcodegtavi.com${groupPath(group.slug)}`;
---

<Layout title={group.seoTitle} description={group.seoDescription}>
  <PageHero
    eyebrow={`PS5 · ${cheats.length} codes · Unconfirmed for GTA 6`}
    title={group.seoTitle}
    subtitle="These are GTA V cheats, listed because they're the most likely to return. Rockstar hasn't confirmed any GTA 6 cheat codes."
    accent="pink"
  />

  <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    <nav aria-label="Breadcrumb" class="text-caption mb-6 text-text-muted">
      <a href="/" class="hover:text-text-primary">Home</a>
      <span class="mx-2">/</span>
      <a href="/cheats/" class="hover:text-text-primary">Cheat Codes</a>
      <span class="mx-2">/</span>
      <span class="text-text-secondary">{group.name}</span>
    </nav>

    <div class="flex max-w-3xl flex-col gap-4 text-text-secondary">
      {group.intro.map((p) => <p class="text-body-md">{p}</p>)}
    </div>

    <div class="mt-8 rounded-xl border border-dashed border-border-default bg-bg-surface p-5">
      <p class="text-body-sm text-text-secondary">
        <strong class="text-text-primary">Status: unconfirmed.</strong> GTA 6 launches November 19, 2026 and Rockstar
        hasn't published any cheat codes. Inputs below are the GTA V PS5 button sequences and phone numbers. We list PS5
        only.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-3 md:grid-cols-2">
      {cheats.map((cheat) => <CheatEntry cheat={cheat} />)}
    </div>

    <section class="mt-14 max-w-3xl">
      <h2 class="text-heading-md text-text-primary">Questions about {group.name.toLowerCase()}</h2>
      <div class="mt-4 flex flex-col gap-3">
        {
          group.faq.map((item) => (
            <details class="group rounded-xl border border-border-default bg-bg-surface p-5 open:border-accent-secondary/40">
              <summary class="text-heading-sm flex cursor-pointer list-none items-center justify-between gap-4 text-text-primary marker:content-none">
                {item.q}
                <svg class="h-4 w-4 shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-45" viewBox="0 0 16 16" fill="none">
                  <path d="M8 2V14M2 8H14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </summary>
              <p class="text-body-md mt-3 text-text-secondary">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-heading-md text-text-primary">More GTA 6 cheat categories</h2>
      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          others.map((g) => (
            <a
              href={groupPath(g.slug)}
              class="press rounded-xl border border-border-default bg-bg-surface p-4 transition-colors duration-150 hover:border-accent-secondary/60"
            >
              <p class="text-heading-sm text-text-primary">{g.name}</p>
              <p class="text-caption mt-1 text-text-muted">{cheatsInGroup(g.slug).length} codes · PS5</p>
            </a>
          ))
        }
      </div>
      <p class="text-body-sm mt-6 text-text-secondary">
        See every code on the <a href="/cheats/" class="text-accent-secondary hover:underline">GTA 6 cheat codes (PS5)</a> page, or compare with <a href="/cheats/gta5-vs-gta6/" class="text-accent-secondary hover:underline">GTA 5 vs GTA 6 cheats</a>.
      </p>
    </section>

    <div class="mt-14 flex flex-col items-center gap-3 rounded-2xl border border-dashed border-border-default p-8 text-center">
      <p class="text-label text-text-muted">Get told when GTA 6 codes are confirmed</p>
      <NotifySignup />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cheatcodegtavi.com/' },
          { '@type': 'ListItem', position: 2, name: 'GTA 6 Cheat Codes (PS5)', item: 'https://cheatcodegtavi.com/cheats/' },
          { '@type': 'ListItem', position: 3, name: group.name, item: url },
        ],
      },
      {
        '@type': 'ItemList',
        name: `${group.name} (GTA V codes, PS5)`,
        numberOfItems: cheats.length,
        itemListElement: cheats.map((cheat, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: cheat.title,
          url: `${url}#${cheat.slug}`,
        })),
      },
      {
        '@type': 'FAQPage',
        mainEntity: group.faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      },
    ],
  })} />
</Layout>

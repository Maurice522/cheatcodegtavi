---
import Layout from '../../layouts/Layout.astro';
import PlatformTabs from '../../components/PlatformTabs.astro';
import CheatCard from '../../components/CheatCard.astro';
import CheatBanner from '../../components/CheatBanner.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import RecentlyViewed from '../../components/RecentlyViewed.astro';
import { getAllCheats, getCheatBySlug, getSimilarCheats, getCheatIcon } from '../../lib/cheats';

// No real GTA6 cheats exist yet — getAllCheats() only returns internal GTA V
// test fixtures (see PLAN.md), which must never be published as live pages.
// Once the cheat pipeline (not yet built) starts writing real entries to
// Mongo, swap this back to generating a path per cheat.
export function getStaticPaths() {
  return [];
}

const { slug } = Astro.params;
const cheat = getCheatBySlug(slug!)!;
const similar = getSimilarCheats(cheat, 4);
const primary = cheat.platforms.ps5 ?? cheat.platforms.xbox;
const icon = getCheatIcon(cheat.category);
---

<Layout title={cheat.title} description={cheat.platforms.ps5?.effect ?? cheat.platforms.xbox?.effect}>
  <div class="mx-auto max-w-4xl px-5 py-12 sm:px-8 sm:py-16">
    <nav class="text-caption mb-6 text-text-muted">
      <a href="/cheats" class="hover:text-text-primary">Cheat Codes</a>
      <span class="mx-2">/</span>
      <span class="capitalize text-text-secondary">{cheat.category}</span>
    </nav>

    {primary && <CheatBanner confidence={primary.confidence} icon={icon} size="lg" />}

    <div class="mt-6 mb-8 flex flex-wrap items-start justify-between gap-4">
      <div>
        <span class="text-label text-accent-secondary">{cheat.category}</span>
        <h1 class="text-display-md mt-2 text-3xl text-text-primary sm:text-5xl">{cheat.title}</h1>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        {cheat.tags.map((tag) => (
          <span class="text-caption rounded-full border border-border-default px-3 py-1 text-text-muted">#{tag}</span>
        ))}
        <FavoriteButton slug={cheat.slug} title={cheat.title} category={cheat.category} />
      </div>
    </div>

    <PlatformTabs cheat={cheat} />

    <div class="mt-10">
      <RecentlyViewed currentSlug={cheat.slug} currentTitle={cheat.title} currentCategory={cheat.category} />
    </div>

    {similar.length > 0 && (
      <div class="mt-12" data-reveal-group>
        <h2 class="text-heading-md mb-5 text-text-primary" data-reveal>Similar Cheat Codes</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {similar.map((c) => (
            <div data-reveal>
              <CheatCard cheat={c} />
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

{primary && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: `${cheat.title} — GTA6 Cheat Code`,
      description: primary.effect,
      about: 'Grand Theft Auto VI',
      step: [
        {
          '@type': 'HowToStep',
          text:
            primary.inputType === 'phone'
              ? `Open your in-game phone and dial ${primary.input}.`
              : `Enter the button combination: ${primary.input}.`,
        },
      ],
    })}
  />
)}

{/* /api/track is the Phase 6 Cloudflare Worker endpoint (PLAN.md §9) — not deployed
    yet, so this beacon is a harmless no-op 404 until then. */}
<script define:vars={{ slug: cheat.slug }}>
  navigator.sendBeacon?.('/api/track', JSON.stringify({ slug, t: Date.now() }));
</script>

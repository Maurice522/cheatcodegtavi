---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CheatEntry from '../../components/CheatEntry.astro';
import NotifySignup from '../../components/NotifySignup.astro';
import { allCheats, cheatGroups, cheatsInGroup, formatTestedDate, groupPath, statusOf } from '../../lib/gta5-cheats';
import { hasLaunched } from '../../lib/launch';
import changelog from '../../data/cheat-changelog.json';

const launched = hasLaunched();
const testedCount = allCheats.filter((c) => statusOf(c) !== 'unconfirmed').length;
const recentUpdates = [...changelog].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);

const faqs = [
  {
    q: 'Are these real GTA 6 cheat codes?',
    a: "No. Rockstar hasn't published any GTA 6 cheat codes. Every code on this page is a GTA V cheat, listed because it is the most likely to return. Each one is marked unconfirmed, and we'll only mark a code as confirmed after testing it in the released game.",
  },
  {
    q: 'How do I enter cheat codes on PS5?',
    a: "In GTA V on PS5 you enter a button sequence during normal gameplay (no pause menu) or dial the matching number on the in-game phone, then a short message confirms the cheat. GTA 6 hasn't confirmed how its cheats are entered; a phone-based system is the most likely carryover.",
  },
  {
    q: 'Will these cheat codes work in GTA 6 on PS5?',
    a: "That's unknown until the game launches on November 19, 2026. Some GTA V inputs may carry over unchanged and some, especially vehicle spawns, can't, because GTA 6 has a different roster. We'll test and update this page.",
  },
  {
    q: 'Do cheat codes disable trophies?',
    a: 'In GTA V, activating a cheat disables trophy unlocks for that play session. We expect GTA 6 to follow the same rule, but it has not been confirmed.',
  },
  {
    q: 'Why only PS5?',
    a: "We list PS5 inputs first. GTA 6 launches on PS5 and Xbox Series X|S, and there is no PC release date yet, so Xbox and PC inputs aren't listed here.",
  },
];
---

<Layout
  title="GTA 6 Cheat Codes (PS5)"
  description="35 GTA V cheat codes most likely to return in GTA 6, with PS5 inputs. Every code is marked unconfirmed until we test it after launch on Nov 19, 2026."
>
  <PageHero
    eyebrow="PS5 · 35 codes · Unconfirmed for GTA 6"
    title="GTA 6 Cheat Codes (PS5)"
    subtitle={launched ? "GTA 6 is out. We're testing each of these GTA V cheats on PS5 and updating their status as we go." : "Rockstar hasn't published any GTA 6 cheat codes yet. Here are the 35 GTA V cheats most likely to return, with PS5 inputs."}
    accent="pink"
  />

  <div class="sticky top-[72px] z-30 border-b border-border-subtle bg-bg-primary/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-3 sm:px-8 lg:flex-row lg:items-center lg:gap-4">
      <label class="relative block lg:w-72 lg:shrink-0">
        <span class="sr-only">Filter cheat codes</span>
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-text-muted" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.6" />
          <path d="M11 11L15 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input
          data-cheat-filter
          type="search"
          placeholder="Filter codes: e.g. wanted, jump, helicopter"
          autocomplete="off"
          class="text-body-sm w-full rounded-full border border-border-default bg-bg-surface py-2 pl-9 pr-4 text-text-primary placeholder:text-text-muted focus:border-accent-secondary/60 focus:outline-none"
        />
      </label>
      <nav aria-label="Cheat categories" class="-mx-5 flex gap-2 overflow-x-auto px-5 pb-1 [scrollbar-width:none] sm:mx-0 sm:px-0 lg:pb-0 [&::-webkit-scrollbar]:hidden">
        {
          cheatGroups.map((group) => (
            <a
              href={`#${group.slug}`}
              class="press text-caption shrink-0 rounded-full border border-border-default px-3 py-1.5 text-text-secondary transition-colors duration-150 hover:border-accent-secondary/60 hover:text-text-primary"
            >
              {group.name}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-12">
    <div class="max-w-3xl text-text-secondary">
      <p class="text-body-md">
        GTA 6 cheat codes aren't available yet, because the game hasn't launched. Until it does, this page lists the GTA V codes most likely to carry over, laid out the way you'd enter them on a PS5 controller. Every entry is labeled <strong class="text-text-primary">Unconfirmed in GTA 6</strong> until we've tested it in the new game.
      </p>
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Status summary">
        <li class="text-caption rounded-full border border-border-default bg-bg-surface px-3 py-1.5">GTA 6 codes confirmed by Rockstar: <strong class="text-text-primary">0</strong></li>
        <li class="text-caption rounded-full border border-border-default bg-bg-surface px-3 py-1.5">Listed here: <strong class="text-text-primary">{allCheats.length} from GTA V</strong></li>
        <li class="text-caption rounded-full border border-border-default bg-bg-surface px-3 py-1.5">Tested in GTA 6: <strong class="text-text-primary">{testedCount}</strong></li>
        <li class="text-caption rounded-full border border-border-default bg-bg-surface px-3 py-1.5">Launch: <strong class="text-text-primary">Nov 19, 2026</strong></li>
        <li class="text-caption rounded-full border border-border-default bg-bg-surface px-3 py-1.5">Platform: <strong class="text-text-primary">PS5 only</strong></li>
      </ul>
      <p class="text-caption mt-3 text-text-muted">
        Tip: tap the star to save a code, or <a href="/cheats/cheat-sheet/" class="text-accent-secondary hover:underline">open the printable cheat sheet</a>. After launch you'll also be able to report whether each code worked.
      </p>
    </div>

    <p data-no-results hidden class="text-body-md mt-10 rounded-xl border border-dashed border-border-default p-8 text-center text-text-secondary">
      No codes match that filter. Try a word from the effect, like "weapons", "car" or "weather".
    </p>

    {
      cheatGroups.map((group) => (
        <section data-cheat-group class="mt-12">
          <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
            <h2 id={group.slug} class="text-heading-md scroll-mt-40 text-text-primary">{group.name}</h2>
            <a href={groupPath(group.slug)} class="text-label text-accent-secondary hover:text-accent-secondary/80">
              Full guide
            </a>
          </div>
          <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
            {cheatsInGroup(group.slug).map((cheat) => (
              <CheatEntry cheat={cheat} compact headingLevel="h3" />
            ))}
          </div>
        </section>
      ))
    }

    <section class="mt-16 max-w-3xl">
      <h2 class="text-heading-md text-text-primary">Recent updates</h2>
      <ul class="mt-3 flex flex-col gap-2">
        {
          recentUpdates.map((entry) => (
            <li class="text-body-sm text-text-secondary">
              <span class="font-semibold text-text-primary">{formatTestedDate(entry.date)}:</span> {entry.text}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-16 max-w-3xl">
      <h2 class="text-heading-md text-text-primary">GTA 6 cheat codes: common questions</h2>
      <div class="mt-4 flex flex-col gap-3">
        {
          faqs.map((item) => (
            <details class="group rounded-xl border border-border-default bg-bg-surface p-5 open:border-accent-secondary/40">
              <summary class="text-heading-sm flex cursor-pointer list-none items-center justify-between gap-4 text-text-primary marker:content-none">
                {item.q}
                <svg class="h-4 w-4 shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-45" viewBox="0 0 16 16" fill="none">
                  <path d="M8 2V14M2 8H14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </summary>
              <p class="text-body-md mt-3 text-text-secondary">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <div class="mt-14 flex flex-col items-center gap-4 rounded-2xl border border-dashed border-border-default p-8 text-center">
      <p class="text-label text-text-muted">Get told when GTA 6 codes are confirmed</p>
      <NotifySignup />
      <div class="flex flex-wrap justify-center gap-3 pt-2">
        <a href="/cheats/gta5-vs-gta6/" class="text-body-sm text-accent-secondary hover:underline">GTA 5 vs GTA 6 cheats</a>
        <a href="/faq/" class="text-body-sm text-accent-secondary hover:underline">Cheat code FAQ</a>
        <a href="/leaks/" class="text-body-sm text-accent-secondary hover:underline">Leaks &amp; updates</a>
      </div>
    </div>
  </div>

  <script>
    const input = document.querySelector<HTMLInputElement>('[data-cheat-filter]');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-cheat-card]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-cheat-group]')];
    const empty = document.querySelector<HTMLElement>('[data-no-results]');

    function applyFilter() {
      const terms = (input?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean);
      for (const card of cards) {
        const text = card.dataset.filterText ?? '';
        card.hidden = !terms.every((t) => text.includes(t));
      }
      for (const group of groups) {
        group.hidden = [...group.querySelectorAll<HTMLElement>('[data-cheat-card]')].every((c) => c.hidden);
      }
      if (empty) empty.hidden = groups.some((g) => !g.hidden);
    }

    if (input) {
      const q = new URLSearchParams(location.search).get('q');
      if (q) input.value = q;
      input.addEventListener('input', applyFilter);
      applyFilter();
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cheatcodegtavi.com/' },
          { '@type': 'ListItem', position: 2, name: 'GTA 6 Cheat Codes (PS5)', item: 'https://cheatcodegtavi.com/cheats/' },
        ],
      },
      {
        '@type': 'ItemList',
        name: 'GTA V cheat codes likely to return in GTA 6 (PS5)',
        numberOfItems: allCheats.length,
        itemListElement: allCheats.map((cheat, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: cheat.title,
          url: `https://cheatcodegtavi.com/cheats/${cheat.group}/#${cheat.slug}`,
        })),
      },
      {
        '@type': 'FAQPage',
        mainEntity: faqs.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      },
    ],
  })} />
</Layout>

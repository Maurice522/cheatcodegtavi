---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CheatIcon from '../../components/CheatIcon.astro';
import { getCheatIcon, type CheatIconName } from '../../lib/cheats';
import gta5Cheats from '../../data/gta5-cheats.json';

interface Gta5Cheat {
  title: string;
  category: string;
  code: string;
  effect: string;
}

const cheats = gta5Cheats as Gta5Cheat[];

// getAllCheats() only ever returns internal GTA V test fixtures (see
// src/data/cheats.json's own header comment) — matching against it here would
// render a false "Confirmed in GTA6" claim linking to a page that doesn't
// exist yet ([slug].astro's getStaticPaths() is intentionally empty). Every
// row stays "Not confirmed yet" until Phase 3's real cheat pipeline ships.
const rows = cheats.map((cheat) => ({ ...cheat, icon: getCheatIcon(cheat.category) as CheatIconName }));
---

<Layout
  title="GTA 5 vs GTA 6 Cheat Codes — Full List"
  description="The complete GTA 5 cheat codes list for PS5, Xbox, and PC — and whether each one has been confirmed to return in GTA 6 yet."
>
  <PageHero
    eyebrow="GTA V Archive"
    title="GTA5 vs GTA6 Cheat Codes"
    subtitle="GTA6's own cheat codes haven't been confirmed yet — here's every classic GTA V code while you wait, and whether it's shown up in GTA6 so far."
    accent="gold"
  />

  <div class="mx-auto max-w-4xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="mb-8 rounded-xl border border-dashed border-border-default bg-bg-surface p-5">
      <p class="text-body-sm text-text-secondary">
        These are <strong class="text-text-primary">GTA V codes</strong>, published here as a reference —
        not GTA6 content. See our <a href="/faq" class="text-accent-secondary hover:underline">FAQ</a> for how
        we expect GTA6's cheat system to work, and <a href="/cheats" class="text-accent-secondary hover:underline">Cheat Codes</a> for
        the real, verified GTA6 list once it exists.
      </p>
    </div>

    <div class="flex flex-col gap-3" data-reveal-group>
      {rows.map((row) => (
        <div data-reveal class="flex flex-col gap-3 rounded-xl border border-border-default bg-bg-surface p-5 sm:flex-row sm:items-center sm:gap-5">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-bg-elevated text-accent-secondary">
            <CheatIcon icon={row.icon} class="h-6 w-6" />
          </div>
          <div class="flex-1">
            <p class="text-heading-sm text-text-primary">{row.title}</p>
            <p class="text-body-sm text-text-secondary">{row.effect}</p>
            <p class="text-caption mt-1 text-accent-secondary" style="font-family: var(--font-heading);">{row.code}</p>
          </div>
          <div class="shrink-0">
            <span class="text-label inline-flex items-center rounded-full border border-border-default px-3 py-1.5 text-text-muted">
              Not confirmed yet
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

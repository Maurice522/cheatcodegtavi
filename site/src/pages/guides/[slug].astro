---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { guides, guidePath, type Guide } from '../../data/guides';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const SITE = 'https://cheatcodegtavi.com';
const url = `${SITE}${guidePath(guide.slug)}`;
const others = guides.filter((g) => g.slug !== guide.slug);
const relatedLabels: Record<string, string> = {
  '/cheats/gta-6/': 'Confirmed GTA 6 cheat codes',
  '/cheats/gta-6/how-to-activate-cheats/': 'How to activate cheats in GTA 6',
  '/cheats/gta-6/tracker/': 'GTA 6 cheat unlock tracker',
  '/cheats/gta-6/250-000/': 'GTA 6 money cheat ($250,000)',
  '/cheats/gta-6/mtl-pumper/': 'GTA 6 MTL Pumper spawn cheat',
  '/characters/': 'GTA 6 characters',
};
const label = (p: string) => relatedLabels[p] ?? guides.find((g) => guidePath(g.slug) === p)?.short ?? p;
---

<Layout title={guide.title} description={guide.description} ogType="article">
  <PageHero eyebrow="GTA 6 guide" title={guide.title} accent="gold" />

  <div class="mx-auto max-w-3xl px-5 py-12 sm:px-8 sm:py-16">
    <nav aria-label="Breadcrumb" class="text-caption mb-6 text-text-muted">
      <a href="/" class="hover:text-text-primary">Home</a>
      <span class="mx-2">/</span>
      <a href="/guides/" class="hover:text-text-primary">GTA 6 Guides</a>
      <span class="mx-2">/</span>
      <span class="text-text-secondary">{guide.short}</span>
    </nav>

    <p class="text-body-lg text-text-secondary" data-answer>
      <strong class="text-text-primary">Short answer:</strong> {guide.answer}
    </p>

    {
      guide.sections.map((s) => (
        <section class="mt-10">
          <h2 class="text-heading-md text-text-primary">{s.heading}</h2>
          {s.paragraphs?.map((p) => <p class="text-body-md mt-3 text-text-secondary">{p}</p>)}
          {s.bullets && (
            <ul class="text-body-md mt-3 flex list-disc flex-col gap-2 pl-6 text-text-secondary">
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
        </section>
      ))
    }

    <section class="mt-10">
      <h2 class="text-heading-md text-text-primary">Questions</h2>
      <div class="mt-4 flex flex-col gap-3">
        {
          guide.faq.map((item) => (
            <details class="rounded-xl border border-border-default bg-bg-surface p-5" open>
              <summary class="text-heading-sm cursor-pointer list-none text-text-primary marker:content-none">{item.q}</summary>
              <p class="text-body-md mt-3 text-text-secondary">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-heading-md text-text-primary">Sources</h2>
      <ul class="text-body-sm mt-3 flex flex-col gap-2 text-text-secondary">
        {guide.sources.map((s) => <li><a href={s.url} rel="nofollow noopener" target="_blank" class="text-accent-secondary hover:underline">{s.name}</a></li>)}
      </ul>
      <p class="text-caption mt-3 text-text-muted">Written from the sources above; we haven't played through this ourselves yet. Last updated {guide.updated}. See our <a href="/editorial-policy/" class="text-accent-secondary hover:underline">editorial policy</a>.</p>
    </section>

    <section class="mt-10">
      <h2 class="text-heading-md text-text-primary">Related</h2>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
        {[...guide.related, ...others.slice(0, 4).map((g) => guidePath(g.slug))].filter((p, i, a) => a.indexOf(p) === i).slice(0, 6).map((p) => (
          <li><a href={p} class="press block rounded-xl border border-border-default bg-bg-surface p-4 text-text-primary hover:border-accent-secondary/60">{label(p)}</a></li>
        ))}
      </ul>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Article',
        '@id': `${url}#article`,
        headline: guide.title,
        description: guide.description,
        url,
        dateModified: guide.updated,
        about: { '@type': 'VideoGame', name: 'Grand Theft Auto VI', alternateName: ['GTA 6', 'GTA VI'], gamePlatform: ['PlayStation 5', 'Xbox Series X|S'] },
        publisher: { '@type': 'Organization', name: 'CheatCodeGTAVI.com', url: SITE },
        citation: guide.sources.map((s) => s.url),
      },
      {
        '@type': 'FAQPage',
        mainEntity: guide.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
          { '@type': 'ListItem', position: 2, name: 'GTA 6 Guides', item: `${SITE}/guides/` },
          { '@type': 'ListItem', position: 3, name: guide.short, item: url },
        ],
      },
    ],
  })} />
</Layout>

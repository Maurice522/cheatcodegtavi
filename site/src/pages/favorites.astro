---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CheatEntry from '../components/CheatEntry.astro';
import { allCheats } from '../lib/gta5-cheats';
---

<Layout title="Favorites" description="Your saved GTA6 cheat codes." noindex>
  <PageHero eyebrow="Your List" title="Favorites" subtitle="Your saved cheats and their codes, kept on this device. Tap a star to remove one." accent="gold" />

  <div class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <favorites-page>
      <div data-empty class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-border-default p-10 text-center">
        <p class="text-body-lg text-text-secondary">Nothing saved yet.</p>
        <p class="text-body-sm max-w-sm text-text-muted">
          Tap the star on any cheat to save it here. Browse the <a href="/cheats/" class="text-accent-secondary hover:underline">PS5 cheat codes</a> to start your list.
        </p>
      </div>

      <div data-filled hidden class="flex flex-col gap-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-body-sm text-text-muted"><span data-count>0</span> saved</p>
          <div class="flex gap-2">
            <button
              type="button"
              data-share
              class="press text-label shadow-glow-pink rounded-full bg-accent-primary px-5 py-2.5 text-text-on-accent transition-transform duration-150 hover:scale-105"
            >
              <span data-share-label>Share My List</span>
            </button>
            <button
              type="button"
              data-clear
              class="press text-label rounded-full border border-border-default px-5 py-2.5 text-text-secondary transition-colors duration-150 hover:text-text-primary"
            >
              Clear All
            </button>
          </div>
        </div>

        <div data-list class="flex flex-col gap-3">
          {
            allCheats.map((cheat) => (
              <div data-fav-card={cheat.slug} data-seq={cheat.ps5?.join(',') ?? ''} data-phone={cheat.phone} hidden>
                <CheatEntry cheat={cheat} />
              </div>
            ))
          }
        </div>
      </div>
    </favorites-page>
  </div>

</Layout>

<script>
  import { readFavorites, removeFavorite } from '../lib/favorites-client';

  class FavoritesPage extends HTMLElement {
    connectedCallback() {
      this.render();
      window.addEventListener('favorites:change', () => this.render());
    }

    render() {
      const entries = readFavorites();
      const empty = this.querySelector<HTMLElement>('[data-empty]');
      const filled = this.querySelector<HTMLElement>('[data-filled]');
      const list = this.querySelector<HTMLElement>('[data-list]');
      const count = this.querySelector<HTMLElement>('[data-count]');
      if (!empty || !filled || !list || !count) return;

      if (entries.length === 0) {
        empty.hidden = false;
        filled.hidden = true;
        return;
      }
      empty.hidden = true;
      filled.hidden = false;
      count.textContent = String(entries.length);

      // Show the saved cheats' full cards, newest first; hide the rest.
      const cards = new Map(
        [...list.querySelectorAll<HTMLElement>('[data-fav-card]')].map((el) => [el.dataset.favCard ?? '', el]),
      );
      for (const card of cards.values()) card.hidden = true;
      list.querySelectorAll('[data-fav-fallback]').forEach((el) => el.remove());

      for (const [position, entry] of entries.entries()) {
        const card = cards.get(entry.slug);
        if (card) {
          card.hidden = false;
          card.style.order = String(position);
          continue;
        }
        // A saved item we no longer have a card for: keep it visible and removable.
        const row = document.createElement('div');
        row.dataset.favFallback = '';
        row.style.order = String(position);
        row.className =
          'flex items-center justify-between gap-3 rounded-xl border border-border-default bg-bg-surface p-4';
        row.innerHTML = `
          <a href="${escapeHtml(entry.url ?? '/cheats/')}" class="min-w-0 flex-1">
            <span class="text-label text-accent-secondary">${escapeHtml(entry.category)}</span>
            <p class="text-heading-sm truncate text-text-primary">${escapeHtml(entry.title)}</p>
          </a>
          <button type="button" data-remove="${escapeHtml(entry.slug)}" aria-label="Remove ${escapeHtml(entry.title)}"
            class="press flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-border-default text-text-muted hover:border-error/60 hover:text-error">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M1 1L11 11M11 1L1 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </button>
        `;
        row.querySelector<HTMLButtonElement>('[data-remove]')?.addEventListener('click', () => removeFavorite(entry.slug));
        list.appendChild(row);
      }
    }
  }

  function escapeHtml(str: string) {
    return str.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);
  }

  customElements.define('favorites-page', FavoritesPage);

  // --- Share the list as a link: the saved cheat names ride in the URL, so anyone
  // who opens it sees the same codes on /shared/. No server involved.
  const shareBtn = document.querySelector<HTMLButtonElement>('[data-share]');
  const shareLabel = document.querySelector<HTMLElement>('[data-share-label]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]');

  clearBtn?.addEventListener('click', () => {
    if (!confirm('Remove all saved cheats?')) return;
    for (const entry of readFavorites()) removeFavorite(entry.slug);
  });

  function buildShareUrl(): string {
    const slugs = readFavorites().map((e) => e.slug);
    return `${location.origin}/shared/?c=${slugs.map(encodeURIComponent).join(',')}`;
  }

  shareBtn?.addEventListener('click', async () => {
    if (readFavorites().length === 0) return;
    const url = buildShareUrl();

    if (navigator.share) {
      try {
        await navigator.share({ title: 'My GTA 6 cheat list', text: 'My saved PS5 cheat codes:', url });
        return;
      } catch {
        // dismissed the share sheet, or sharing failed: fall back to copying the link
      }
    }

    try {
      await navigator.clipboard.writeText(url);
      if (shareLabel) shareLabel.textContent = 'Link copied';
    } catch {
      // Clipboard blocked: show the link so it can be copied by hand.
      window.prompt('Copy this link to share your list:', url);
      return;
    }
    setTimeout(() => {
      if (shareLabel) shareLabel.textContent = 'Share My List';
    }, 2000);
  });
</script>

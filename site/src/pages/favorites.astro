---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CheatEntry from '../components/CheatEntry.astro';
import { allCheats } from '../lib/gta5-cheats';
---

<Layout title="Favorites" description="Your saved GTA6 cheat codes." noindex>
  <PageHero eyebrow="Your List" title="Favorites" subtitle="Your saved cheats and their codes, kept on this device. Tap a star to remove one." accent="gold" />

  <div class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <favorites-page>
      <div data-empty class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-border-default p-10 text-center">
        <p class="text-body-lg text-text-secondary">Nothing saved yet.</p>
        <p class="text-body-sm max-w-sm text-text-muted">
          Tap the star on any cheat to save it here. Browse the <a href="/cheats/" class="text-accent-secondary hover:underline">PS5 cheat codes</a> to start your list.
        </p>
      </div>

      <div data-filled hidden class="flex flex-col gap-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-body-sm text-text-muted"><span data-count>0</span> saved</p>
          <div class="flex gap-2">
            <button
              type="button"
              data-share
              class="press text-label shadow-glow-pink rounded-full bg-accent-primary px-5 py-2.5 text-text-on-accent transition-transform duration-150 hover:scale-105"
            >
              Share My Cheat Sheet
            </button>
            <button
              type="button"
              data-clear
              class="press text-label rounded-full border border-border-default px-5 py-2.5 text-text-secondary transition-colors duration-150 hover:text-text-primary"
            >
              Clear All
            </button>
          </div>
        </div>

        <div data-list class="flex flex-col gap-3">
          {
            allCheats.map((cheat) => (
              <div data-fav-card={cheat.slug} data-seq={cheat.ps5?.join(',') ?? ''} data-phone={cheat.phone} hidden>
                <CheatEntry cheat={cheat} />
              </div>
            ))
          }
        </div>
      </div>
    </favorites-page>
  </div>

  <canvas data-share-canvas width="1080" height="1080" class="hidden"></canvas>
</Layout>

<script>
  import { readFavorites, removeFavorite, type FavoriteEntry } from '../lib/favorites-client';

  class FavoritesPage extends HTMLElement {
    connectedCallback() {
      this.render();
      window.addEventListener('favorites:change', () => this.render());
    }

    render() {
      const entries = readFavorites();
      const empty = this.querySelector<HTMLElement>('[data-empty]');
      const filled = this.querySelector<HTMLElement>('[data-filled]');
      const list = this.querySelector<HTMLElement>('[data-list]');
      const count = this.querySelector<HTMLElement>('[data-count]');
      if (!empty || !filled || !list || !count) return;

      if (entries.length === 0) {
        empty.hidden = false;
        filled.hidden = true;
        return;
      }
      empty.hidden = true;
      filled.hidden = false;
      count.textContent = String(entries.length);

      // Show the saved cheats' full cards, newest first; hide the rest.
      const cards = new Map(
        [...list.querySelectorAll<HTMLElement>('[data-fav-card]')].map((el) => [el.dataset.favCard ?? '', el]),
      );
      for (const card of cards.values()) card.hidden = true;
      list.querySelectorAll('[data-fav-fallback]').forEach((el) => el.remove());

      for (const [position, entry] of entries.entries()) {
        const card = cards.get(entry.slug);
        if (card) {
          card.hidden = false;
          card.style.order = String(position);
          continue;
        }
        // A saved item we no longer have a card for: keep it visible and removable.
        const row = document.createElement('div');
        row.dataset.favFallback = '';
        row.style.order = String(position);
        row.className =
          'flex items-center justify-between gap-3 rounded-xl border border-border-default bg-bg-surface p-4';
        row.innerHTML = `
          <a href="${escapeHtml(entry.url ?? '/cheats/')}" class="min-w-0 flex-1">
            <span class="text-label text-accent-secondary">${escapeHtml(entry.category)}</span>
            <p class="text-heading-sm truncate text-text-primary">${escapeHtml(entry.title)}</p>
          </a>
          <button type="button" data-remove="${escapeHtml(entry.slug)}" aria-label="Remove ${escapeHtml(entry.title)}"
            class="press flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-border-default text-text-muted hover:border-error/60 hover:text-error">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M1 1L11 11M11 1L1 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </button>
        `;
        row.querySelector<HTMLButtonElement>('[data-remove]')?.addEventListener('click', () => removeFavorite(entry.slug));
        list.appendChild(row);
      }
    }
  }

  function escapeHtml(str: string) {
    return str.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);
  }

  customElements.define('favorites-page', FavoritesPage);

  // --- Shareable cheat-sheet image — pure client-side canvas render, no backend.
  const shareBtn = document.querySelector<HTMLButtonElement>('[data-share]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-share-canvas]');

  clearBtn?.addEventListener('click', () => {
    if (!confirm('Remove all saved cheats?')) return;
    for (const entry of readFavorites()) removeFavorite(entry.slug);
  });

  shareBtn?.addEventListener('click', async () => {
    const entries = readFavorites();
    if (!canvas || entries.length === 0) return;
    const dataUrl = renderCheatSheet(canvas, entries);

    const blob = await (await fetch(dataUrl)).blob();
    const file = new File([blob], 'my-gta6-cheat-sheet.png', { type: 'image/png' });

    if (navigator.canShare?.({ files: [file] })) {
      try {
        await navigator.share({ files: [file], title: 'My GTA6 Cheat Sheet' });
        return;
      } catch {
        // user cancelled the share sheet — fall through to download
      }
    }

    const link = document.createElement('a');
    link.href = dataUrl;
    link.download = 'my-gta6-cheat-sheet.png';
    link.click();
  });

  const MAX_SHEET_ENTRIES = 12;
  const CHIP = 46;
  const CHIP_GAP = 8;
  const FACE_COLORS: Record<string, string> = { Triangle: '#3ddc97', Circle: '#ff6b7a', X: '#7fb0ff', Square: '#ff9ad5' };

  function roundedRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
    ctx.beginPath();
    if (ctx.roundRect) ctx.roundRect(x, y, w, h, r);
    else ctx.rect(x, y, w, h);
  }

  // Buttons are drawn as shapes, not font glyphs, so they look the same on every device.
  function drawButton(ctx: CanvasRenderingContext2D, button: string, x: number, y: number) {
    const face = FACE_COLORS[button];
    roundedRect(ctx, x, y, CHIP, CHIP, 9);
    ctx.fillStyle = '#12141f';
    ctx.fill();
    ctx.lineWidth = 2;
    ctx.strokeStyle = face ?? '#343a55';
    ctx.stroke();

    const cx = x + CHIP / 2;
    const cy = y + CHIP / 2;
    ctx.lineWidth = 3;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = face ?? '#f1f2f8';

    if (button === 'Triangle') {
      ctx.beginPath();
      ctx.moveTo(cx, cy - 11);
      ctx.lineTo(cx + 12, cy + 9);
      ctx.lineTo(cx - 12, cy + 9);
      ctx.closePath();
      ctx.stroke();
    } else if (button === 'Circle') {
      ctx.beginPath();
      ctx.arc(cx, cy, 11, 0, Math.PI * 2);
      ctx.stroke();
    } else if (button === 'X') {
      ctx.beginPath();
      ctx.moveTo(cx - 9, cy - 9);
      ctx.lineTo(cx + 9, cy + 9);
      ctx.moveTo(cx + 9, cy - 9);
      ctx.lineTo(cx - 9, cy + 9);
      ctx.stroke();
    } else if (button === 'Square') {
      ctx.strokeRect(cx - 10, cy - 10, 20, 20);
    } else if (button === 'Left' || button === 'Right' || button === 'Up' || button === 'Down') {
      const angle = { Right: 0, Down: Math.PI / 2, Left: Math.PI, Up: -Math.PI / 2 }[button];
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(angle);
      ctx.beginPath();
      ctx.moveTo(-11, 0);
      ctx.lineTo(11, 0);
      ctx.moveTo(4, -7);
      ctx.lineTo(11, 0);
      ctx.lineTo(4, 7);
      ctx.stroke();
      ctx.restore();
    } else {
      ctx.fillStyle = '#f1f2f8';
      ctx.font = '700 19px Arial';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(button, cx, cy + 1);
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
    }
  }

  function renderCheatSheet(canvas: HTMLCanvasElement, entries: FavoriteEntry[]): string {
    // Inputs come from the cards already on this page.
    const inputs = new Map<string, { seq: string[]; phone: string }>();
    document.querySelectorAll<HTMLElement>('[data-fav-card]').forEach((el) => {
      inputs.set(el.dataset.favCard ?? '', {
        seq: (el.dataset.seq ?? '').split(',').filter(Boolean),
        phone: el.dataset.phone ?? '',
      });
    });

    const shown = entries.slice(0, MAX_SHEET_ENTRIES);
    const HEADER = 200;
    const ROW = 150;
    const FOOTER = 130 + (entries.length > shown.length ? 40 : 0);
    const W = 1080;
    const H = Math.max(1080, HEADER + shown.length * ROW + FOOTER);
    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext('2d')!;

    // Background — Vice-noir gradient, matches the site's ink/neon palette.
    const bg = ctx.createLinearGradient(0, 0, W, H);
    bg.addColorStop(0, '#1b0f26');
    bg.addColorStop(0.5, '#05060a');
    bg.addColorStop(1, '#07131a');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);

    const glow = (x: number, y: number, r: number, color: string) => {
      const g = ctx.createRadialGradient(x, y, 0, x, y, r);
      g.addColorStop(0, color);
      g.addColorStop(1, 'transparent');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);
    };
    glow(120, 120, 500, 'rgba(255,46,158,0.22)');
    glow(W - 120, H - 200, 550, 'rgba(33,230,230,0.18)');

    // Header
    ctx.textBaseline = 'alphabetic';
    ctx.fillStyle = '#ffffff';
    ctx.font = '700 34px Arial';
    ctx.fillText('CHEATCODE', 64, 100);
    ctx.fillStyle = '#ff2e9e';
    const w1 = ctx.measureText('CHEATCODE').width;
    ctx.fillText('GTAVI', 64 + w1, 100);

    ctx.fillStyle = '#a8adc4';
    ctx.font = '400 22px Arial';
    ctx.fillText('MY PS5 CHEAT SHEET', 64, 140);

    // Entries: title, then the PS5 input (or the phone number for phone-only cheats)
    let y = HEADER;
    for (const entry of shown) {
      ctx.fillStyle = '#ffffff';
      ctx.font = '700 36px Arial';
      ctx.fillText(entry.title, 64, y + 30);

      const input = inputs.get(entry.slug);
      if (input && input.seq.length > 0) {
        input.seq.forEach((button, i) => drawButton(ctx, button, 64 + i * (CHIP + CHIP_GAP), y + 52));
      } else if (input?.phone) {
        ctx.fillStyle = '#21e6e6';
        ctx.font = '600 26px Arial';
        ctx.fillText(`Phone: ${input.phone}`, 64, y + 86);
      } else {
        ctx.fillStyle = '#21e6e6';
        ctx.font = '600 20px Arial';
        ctx.fillText(entry.category.toUpperCase(), 64, y + 80);
      }
      y += ROW;
    }

    if (entries.length > shown.length) {
      ctx.fillStyle = '#a8adc4';
      ctx.font = '400 22px Arial';
      ctx.fillText(`+ ${entries.length - shown.length} more on cheatcodegtavi.com`, 64, y + 10);
    }

    // Footer
    ctx.fillStyle = '#a8adc4';
    ctx.font = '400 20px Arial';
    ctx.fillText('GTA V codes, unconfirmed for GTA 6', 64, H - 96);
    ctx.fillStyle = '#ffffff';
    ctx.font = '600 24px Arial';
    ctx.fillText('cheatcodegtavi.com', 64, H - 60);

    return canvas.toDataURL('image/png');
  }
</script>

---
import type { Leak } from '../lib/leaks';

interface Props {
  leak: Leak;
}

const { leak } = Astro.props;

const credibilityStyles: Record<Leak['credibility'], string> = {
  official: 'bg-verified/15 text-verified border-verified/30',
  confirmed: 'bg-accent-secondary/15 text-accent-secondary border-accent-secondary/30',
  rumor: 'bg-rumored/15 text-rumored border-rumored/30',
};

const credibilityLabels: Record<Leak['credibility'], string> = {
  official: 'Official',
  confirmed: 'Confirmed',
  rumor: 'Rumor',
};

const sourceName = leak.sourceName ?? leak.sourceLinks[0]?.title;

const date = new Date(leak.publishedAt).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<a
  href={`/leaks/${leak.slug}`}
  class="group flex flex-col overflow-hidden rounded-xl border border-border-default bg-bg-surface transition-colors duration-200 hover:border-accent-secondary/50"
>
  {leak.image && (
    <div class="aspect-video w-full overflow-hidden bg-bg-elevated">
      <img
        src={leak.image}
        alt=""
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    </div>
  )}
  <div class="flex flex-1 flex-col gap-2 p-5">
    <div class="flex items-center justify-between gap-3">
      <span class:list={['text-label inline-flex items-center rounded-full border px-2.5 py-1', credibilityStyles[leak.credibility]]}>
        {credibilityLabels[leak.credibility]}
      </span>
      <span class="text-caption text-text-muted">
        {sourceName && <span class="uppercase">{sourceName}</span>}
        {sourceName && ' · '}
        <time>{date}</time>
      </span>
    </div>
    <h3 class="text-heading-sm text-text-primary">{leak.title}</h3>
    <p class="text-body-sm line-clamp-3 text-text-secondary">{leak.summary}</p>
  </div>
</a>

---
// Reusable original banner header for listing pages — gradient + scanline texture,
// no game assets. Keeps every section page from being a bare text header.
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  accent?: 'pink' | 'cyan' | 'purple' | 'gold';
}

const { eyebrow, title, subtitle, accent = 'pink' } = Astro.props;

const accentColors: Record<string, string> = {
  pink: 'var(--color-pink-500)',
  cyan: 'var(--color-cyan-500)',
  purple: 'var(--color-purple-500)',
  gold: 'var(--color-gold-500)',
};

const glow = accentColors[accent];
---

<section class="bg-scanlines relative overflow-hidden border-b border-border-subtle" data-cursor-glow>
  <div
    class="pointer-events-none absolute inset-0"
    style={`background: radial-gradient(circle at 15% 30%, color-mix(in srgb, ${glow} 20%, transparent), transparent 50%), radial-gradient(circle at 85% 70%, color-mix(in srgb, var(--color-cyan-500) 12%, transparent), transparent 55%);`}
  />
  <div class="relative mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    {eyebrow && <span class="text-label" style={`color: ${glow};`}>{eyebrow}</span>}
    <h1 class="text-display-md mt-2 text-3xl text-text-primary sm:text-5xl">{title}</h1>
    {subtitle && <p class="text-body-lg mt-4 max-w-xl text-text-secondary">{subtitle}</p>}
  </div>
</section>

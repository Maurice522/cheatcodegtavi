---
// Post-launch replacement for the release countdown: how to activate a GTA 6
// cheat on PS5, as reported by Polygon and Eurogamer.
const steps = [
  { n: '1', title: 'Finish the story', text: 'Cheats stay locked until the credits roll.' },
  { n: '2', title: 'Unlock the cheat', text: 'Each one has its own requirement.' },
  { n: '3', title: 'Open your phone', text: 'Press Up on the D-pad.' },
  { n: '4', title: 'Hold L1 + R1', text: 'LB + RB on Xbox, then enter the D-pad code.' },
];
---

<section aria-labelledby="activate-heading" class="w-full max-w-3xl">
  <h2 id="activate-heading" class="text-label mb-4 text-text-primary [text-shadow:0_1px_6px_rgb(0_0_0_/_0.9)]">How to activate cheats in GTA 6</h2>
  <ol class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
    {
      steps.map((s) => (
        <li class="shadow-glow-pink flex flex-col items-center gap-1.5 rounded-xl border border-border-default bg-bg-elevated/90 px-3 py-4 text-center">
          <span class="text-display-md flex h-9 w-9 items-center justify-center rounded-full bg-accent-primary/15 text-lg text-accent-primary" aria-hidden="true">{s.n}</span>
          <span class="text-body-sm font-semibold text-text-primary">{s.title}</span>
          <span class="text-caption text-text-secondary">{s.text}</span>
        </li>
      ))
    }
  </ol>
  <p class="text-caption mt-3 text-text-secondary [text-shadow:0_1px_6px_rgb(0_0_0_/_0.9)]">
    Save first: a cheat turns off saving and trophies for that session. <a href="/cheats/gta-6/how-to-activate-cheats/" class="text-accent-secondary hover:underline">Full guide</a> · <a href="/cheats/gta-6/tracker/" class="text-accent-secondary hover:underline">Track your unlocks</a>
  </p>
</section>

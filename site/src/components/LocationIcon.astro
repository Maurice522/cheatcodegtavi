---
// Original, simple line-art icons per location archetype — no game assets.
interface Props {
  icon: 'skyline' | 'keys' | 'wetlands' | 'motel' | 'farmland' | 'mountain';
  class?: string;
}

const { icon, class: className = 'h-8 w-8' } = Astro.props;
---

{
  icon === 'skyline' && (
    <svg viewBox="0 0 32 32" class={className} fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M3 28V14l4-3v17" />
      <path d="M9 28V9l5-4v23" />
      <path d="M16 28V13l4 3v12" />
      <path d="M22 28V16l4-2v14" />
      <path d="M2 28h28" />
    </svg>
  )
}
{
  icon === 'keys' && (
    <svg viewBox="0 0 32 32" class={className} fill="none" stroke="currentColor" stroke-width="1.6">
      <ellipse cx="8" cy="18" rx="5" ry="3" />
      <ellipse cx="18" cy="21" rx="4" ry="2.5" />
      <ellipse cx="26" cy="16" rx="3" ry="2" />
      <path d="M2 24c8 3 20 3 28-2" stroke-dasharray="1 3" />
    </svg>
  )
}
{
  icon === 'wetlands' && (
    <svg viewBox="0 0 32 32" class={className} fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M2 12v16M2 12c2-2 4 2 6 0s4 2 6 0" />
      <path d="M14 20v8M14 20c2-2 4 2 6 0s4 2 6 0" />
      <path d="M2 26h28" />
    </svg>
  )
}
{
  icon === 'motel' && (
    <svg viewBox="0 0 32 32" class={className} fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M3 28V13l13-8 13 8v15" />
      <path d="M12 28V18h8v10" />
      <circle cx="16" cy="6" r="1.4" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  icon === 'farmland' && (
    <svg viewBox="0 0 32 32" class={className} fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M2 26h28" />
      <path d="M6 26V10l6 4 6-6 6 6 4-3v15" />
      <path d="M6 26v-6h20v6" />
    </svg>
  )
}
{
  icon === 'mountain' && (
    <svg viewBox="0 0 32 32" class={className} fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M2 27 11 12l5 7 3-4 11 12" />
      <path d="M9 27 16 16l4 5" />
    </svg>
  )
}

---
const links = [
  { href: '/cheats', label: 'Cheat Codes' },
  { href: '/leaks', label: 'Leaks & Updates' },
  { href: '/characters', label: 'Characters' },
  { href: '/locations', label: 'Locations' },
  { href: '/trailers', label: 'Trailers' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border-subtle bg-bg-primary/85 backdrop-blur-md relative">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-4 sm:px-8">
    <a href="/" class="text-lg text-text-primary sm:text-2xl" style="font-family: var(--font-display);">
      CHEAT<span class="text-accent-primary">CODE</span>GTAVI
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        links.map((link) => {
          const active = currentPath.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                class:list={[
                  'press text-label rounded-full px-4 py-2 transition-colors duration-150',
                  active
                    ? 'bg-accent-primary/15 text-accent-primary'
                    : 'text-text-secondary hover:text-text-primary',
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <site-search class="relative">
        <button
          type="button"
          data-search-toggle
          aria-label="Search cheat codes"
          aria-expanded="false"
          class="press flex h-10 w-10 items-center justify-center rounded-full border border-border-default text-text-primary hover:border-accent-secondary/60"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.6" />
            <path d="M11 11L15 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
        <form
          data-search-form
          hidden
          action="/cheats"
          class="absolute right-0 top-full mt-2 flex w-[min(78vw,320px)] items-center gap-2 rounded-xl border border-border-default bg-bg-surface p-2 shadow-elevation-md"
        >
          <input
            data-search-input
            type="search"
            name="q"
            placeholder="Search cheat codes…"
            autocomplete="off"
            class="text-body-sm w-full rounded-lg border border-border-default bg-bg-primary px-3 py-2 text-text-primary placeholder:text-text-muted focus:border-accent-secondary/60 focus:outline-none"
          />
        </form>
      </site-search>

      <a
        href="/favorites"
        aria-label="Your saved cheats"
        class="press relative flex h-10 w-10 items-center justify-center rounded-full border border-border-default text-text-primary hover:border-accent-tertiary/60"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path
            d="M8 1.5l1.9 4.1 4.4.6-3.2 3.1.8 4.4L8 11.6l-3.9 2.1.8-4.4-3.2-3.1 4.4-.6z"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
        </svg>
        <span
          data-favorites-count
          class="text-caption absolute -right-1 -top-1 hidden h-4 min-w-4 items-center justify-center rounded-full bg-accent-tertiary px-1 leading-none text-text-on-accent"
          style="font-size: 10px;"
        >0</span>
      </a>

      <theme-toggle>
        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle light or dark theme"
          class="press flex h-10 w-10 items-center justify-center rounded-full border border-border-default text-text-primary hover:border-accent-secondary/60"
        >
          <svg data-icon-sun width="16" height="16" viewBox="0 0 16 16" fill="none" class="hidden">
            <circle cx="8" cy="8" r="3.5" stroke="currentColor" stroke-width="1.6" />
            <path
              d="M8 0.5V2.5M8 13.5V15.5M15.5 8H13.5M2.5 8H0.5M13.3 2.7L11.9 4.1M4.1 11.9L2.7 13.3M13.3 13.3L11.9 11.9M4.1 4.1L2.7 2.7"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
          <svg data-icon-moon width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path
              d="M14 9.5A6.5 6.5 0 1 1 6.5 2a5 5 0 0 0 7.5 7.5z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </theme-toggle>

      <site-nav-menu class="lg:hidden">
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-label="Toggle navigation menu"
        class="press flex h-10 w-10 items-center justify-center rounded-full border border-border-default text-text-primary"
      >
        <svg data-icon-open width="18" height="14" viewBox="0 0 18 14" fill="none">
          <path d="M0 1H18" stroke="currentColor" stroke-width="2" />
          <path d="M0 7H18" stroke="currentColor" stroke-width="2" />
          <path d="M0 13H18" stroke="currentColor" stroke-width="2" />
        </svg>
        <svg data-icon-close width="16" height="16" viewBox="0 0 16 16" fill="none" class="hidden">
          <path d="M1 1L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path d="M15 1L1 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>

      <div
        data-menu-panel
        hidden
        class="absolute inset-x-0 top-full border-b border-border-subtle bg-bg-primary px-5 pb-6 shadow-elevation-md"
      >
        <ul class="flex flex-col gap-1 pt-2">
          {
            links.map((link) => {
              const active = currentPath.startsWith(link.href);
              return (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      'text-label block rounded-lg px-4 py-3 transition-colors duration-150',
                      active
                        ? 'bg-accent-primary/15 text-accent-primary'
                        : 'text-text-secondary hover:text-text-primary',
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
      </site-nav-menu>
    </div>
  </nav>
</header>

<script>
  import { readFavorites } from '../lib/favorites-client';

  function syncFavoritesBadge() {
    const badge = document.querySelector<HTMLElement>('[data-favorites-count]');
    if (!badge) return;
    const count = readFavorites().length;
    badge.textContent = String(count);
    badge.classList.toggle('hidden', count === 0);
    badge.classList.toggle('flex', count > 0);
  }
  syncFavoritesBadge();
  window.addEventListener('favorites:change', syncFavoritesBadge);

  class SiteSearch extends HTMLElement {
    connectedCallback() {
      const toggle = this.querySelector<HTMLButtonElement>('[data-search-toggle]');
      const form = this.querySelector<HTMLFormElement>('[data-search-form]');
      const input = this.querySelector<HTMLInputElement>('[data-search-input]');
      if (!toggle || !form || !input) return;

      const close = () => {
        form.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
      };

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        if (expanded) {
          close();
        } else {
          form.hidden = false;
          toggle.setAttribute('aria-expanded', 'true');
          input.focus();
        }
      });

      document.addEventListener('click', (e) => {
        if (!this.contains(e.target as Node)) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    }
  }

  customElements.define('site-search', SiteSearch);

  class SiteNavMenu extends HTMLElement {
    connectedCallback() {
      const toggle = this.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const panel = this.querySelector<HTMLElement>('[data-menu-panel]');
      const iconOpen = this.querySelector('[data-icon-open]');
      const iconClose = this.querySelector('[data-icon-close]');
      if (!toggle || !panel) return;

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        panel.hidden = expanded;
        iconOpen?.classList.toggle('hidden', !expanded);
        iconClose?.classList.toggle('hidden', expanded);
      });
    }
  }

  customElements.define('site-nav-menu', SiteNavMenu);

  class ThemeToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const sunIcon = this.querySelector('[data-icon-sun]');
      const moonIcon = this.querySelector('[data-icon-moon]');
      if (!button) return;

      const sync = () => {
        const isLight = document.documentElement.dataset.theme === 'light';
        sunIcon?.classList.toggle('hidden', !isLight);
        moonIcon?.classList.toggle('hidden', isLight);
      };
      sync();

      button.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        sync();
      });
    }
  }

  customElements.define('theme-toggle', ThemeToggle);
</script>

---
// Original synthwave Vice-noir skyline illustration — hand-built vector art (no game
// assets, no likenesses), used purely to set mood behind the hero copy.
---

<div class="hero-art pointer-events-none absolute inset-x-0 bottom-0 h-[45%] overflow-hidden sm:h-[55%]">
  <svg
    viewBox="0 0 1440 700"
    preserveAspectRatio="xMidYMax slice"
    class="h-full w-full"
    role="img"
    aria-label="Stylized skyline at sunset"
  >
    <defs>
      <radialGradient id="sunGradient" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#FFDE8A" />
        <stop offset="45%" stop-color="#FF6BC0" />
        <stop offset="100%" stop-color="#8B3EF5" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="gridFade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#21E6E6" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#21E6E6" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="skylineFade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#2A3350" />
        <stop offset="100%" stop-color="#0B0D14" />
      </linearGradient>
    </defs>

    <!-- Sun -->
    <g class="hero-art-sun" style="transform-origin: 720px 480px;">
      <circle cx="720" cy="480" r="170" fill="url(#sunGradient)" />
    </g>

    <!-- Perspective floor grid -->
    <g class="hero-art-grid" stroke="url(#gridFade)" stroke-width="1.5">
      <line x1="0" y1="560" x2="1440" y2="560" />
      <line x1="0" y1="585" x2="1440" y2="585" />
      <line x1="0" y1="615" x2="1440" y2="615" />
      <line x1="0" y1="650" x2="1440" y2="650" />
      <line x1="0" y1="695" x2="1440" y2="695" />
      <line x1="720" y1="560" x2="120" y2="700" />
      <line x1="720" y1="560" x2="420" y2="700" />
      <line x1="720" y1="560" x2="720" y2="700" />
      <line x1="720" y1="560" x2="1020" y2="700" />
      <line x1="720" y1="560" x2="1320" y2="700" />
    </g>

    <!-- Skyline silhouette -->
    <g fill="url(#skylineFade)" stroke="#3A4058" stroke-width="1">
      <rect x="40" y="440" width="70" height="180" />
      <rect x="120" y="480" width="50" height="140" />
      <rect x="185" y="410" width="85" height="210" />
      <rect x="290" y="460" width="60" height="160" />
      <rect x="900" y="470" width="65" height="150" />
      <rect x="980" y="420" width="90" height="200" />
      <rect x="1085" y="490" width="55" height="130" />
      <rect x="1160" y="450" width="75" height="170" />
      <rect x="1260" y="480" width="60" height="140" />
      <rect x="1340" y="430" width="80" height="190" />
    </g>
    <g fill="#FFC94A" opacity="0.75">
      <rect x="60" y="470" width="6" height="6" />
      <rect x="80" y="500" width="6" height="6" />
      <rect x="205" y="450" width="6" height="6" />
      <rect x="230" y="490" width="6" height="6" />
      <rect x="1000" y="460" width="6" height="6" />
      <rect x="1180" y="480" width="6" height="6" />
      <rect x="1360" y="470" width="6" height="6" />
    </g>

    <!-- Palm silhouettes (foreground) -->
    <g fill="#12151F" stroke="#FF6BC0" stroke-width="0.75" stroke-opacity="0.5" class="hero-art-palm hero-art-palm-a" style="transform-origin: 160px 620px;">
      <path d="M158 620 C150 560 165 520 160 480" stroke="#12151F" stroke-width="10" fill="none" stroke-linecap="round" />
      <path d="M160 485 C120 460 90 470 70 450 C100 445 135 450 160 470 C165 440 155 410 130 390 C160 400 175 430 178 465 C195 435 225 425 255 430 C230 445 205 465 195 485 C220 480 245 490 260 510 C230 500 205 495 185 500 Z" />
    </g>
    <g fill="#12151F" stroke="#21E6E6" stroke-width="0.75" stroke-opacity="0.5" class="hero-art-palm hero-art-palm-b" style="transform-origin: 1290px 640px;">
      <path d="M1288 640 C1280 580 1295 540 1290 500" stroke="#12151F" stroke-width="10" fill="none" stroke-linecap="round" />
      <path d="M1290 505 C1250 480 1220 490 1200 470 C1230 465 1265 470 1290 490 C1295 460 1285 430 1260 410 C1290 420 1305 450 1308 485 C1325 455 1355 445 1385 450 C1360 465 1335 485 1325 505 C1350 500 1375 510 1390 530 C1360 520 1335 515 1315 520 Z" />
    </g>
  </svg>
</div>

<style>
  .hero-art {
    opacity: 0;
    transform: scale(1.05);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-art {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-art {
      animation: hero-art-in 1.1s var(--ease-out) 0.15s forwards;
    }
    .hero-art-sun {
      animation: hero-sun-pulse 6s ease-in-out infinite;
    }
    .hero-art-palm-a {
      animation: hero-palm-sway 7s ease-in-out infinite;
    }
    .hero-art-palm-b {
      animation: hero-palm-sway 8s ease-in-out infinite -2s;
    }
    .hero-art-grid line {
      animation: hero-grid-drift 4s linear infinite;
    }
  }

  @keyframes hero-art-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-sun-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.04);
      opacity: 0.9;
    }
  }

  @keyframes hero-palm-sway {
    0%,
    100% {
      transform: rotate(-1.5deg);
    }
    50% {
      transform: rotate(1.5deg);
    }
  }

  @keyframes hero-grid-drift {
    0% {
      transform: translateY(-6px);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    100% {
      transform: translateY(6px);
      opacity: 0;
    }
  }
</style>
